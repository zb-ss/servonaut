# AppArmor profile for the Servonaut desktop window.
#
# WebKitGTK renders pages in processes it sandboxes with bubblewrap, and
# bubblewrap needs an unprivileged user namespace. Ubuntu 24.04 and later let
# a program create one only when its AppArmor profile allows "userns". This
# profile confines nothing: it names the launcher and grants that permission.
# The programs the launcher starts, bubblewrap included, run under it.
#
# Written for AppArmor 4. The package disables it where only older AppArmor
# is installed and enables it once AppArmor 4 arrives.

abi <abi/4.0>,
include <tunables/global>

profile servonaut-desktop @INSTALL_ROOT@/servonaut-desktop flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/servonaut-desktop>
}
