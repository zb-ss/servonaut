{
  "schema_version": 1,
  "process_argv_max_count": 96,
  "selftest_stdin_max_bytes": 4096,
  "stdout_stderr_max_bytes": 65536,
  "transcript_max_bytes": 262144,
  "public_command_timeout_seconds": 20,
  "selftest_timeout_seconds": 120,
  "child_rejection_timeout_seconds": 10,
  "mcp_initialize_timeout_seconds": 20,
  "mcp_request_timeout_seconds": 20,
  "mcp_shutdown_timeout_seconds": 10,
  "mcp_frame_max_bytes": 1048576,
  "window_session_timeout_seconds": 120,
  "window_render_settle_seconds": 3,
  "window_shutdown_timeout_seconds": 20,
  "selftest_targets": [
    "linux-x64-ubuntu-22.04",
    "windows-x64",
    "macos-x64",
    "macos-arm64"
  ],
  "window_smoke_targets": [
    "linux-x64-ubuntu-22.04"
  ]
}
