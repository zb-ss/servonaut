{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servonaut.dev/schemas/desktop-source-notices-v1.json",
  "title": "Servonaut desktop notices from pinned source archives",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "download", "archives"],
  "properties": {
    "schema_version": {"const": 1},
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_host",
        "max_archive_bytes",
        "max_expanded_bytes",
        "download_timeout_seconds",
        "socket_timeout_seconds"
      ],
      "properties": {
        "origin_host": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "max_archive_bytes": {"type": "integer", "minimum": 1},
        "max_expanded_bytes": {"type": "integer", "minimum": 1},
        "download_timeout_seconds": {"type": "integer", "minimum": 1},
        "socket_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["distribution", "version", "targets", "url", "sha256", "notices"],
        "properties": {
          "distribution": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"},
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "windows-x64",
                "macos-x64",
                "macos-arm64",
                "linux-x64-ubuntu-22.04"
              ]
            }
          },
          "url": {"type": "string", "pattern": "^https://[^?#]+\\.tar\\.gz$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "notices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["member", "payload_path", "sha256"],
              "properties": {
                "member": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+/[A-Za-z0-9_.+-]+$"},
                "payload_path": {
                  "type": "string",
                  "pattern": "^_internal/notices/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                },
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
