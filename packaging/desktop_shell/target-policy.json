{
  "schema_version": 1,
  "targets": {
    "windows-x64": {
      "platform": "win32",
      "architecture": "x86_64",
      "python_version": "3.12",
      "requirements_lock": "requirements/windows-x64.txt",
      "archive": {
        "format": "zip",
        "extension": "zip",
        "name_template": "servonaut-desktop-{product_version}-{target}.{extension}"
      },
      "forbidden_modules": [
        "readline",
        "faster_whisper",
        "ctranslate2",
        "sherpa_onnx",
        "sounddevice",
        "numpy"
      ],
      "forbidden_path_patterns": [
        "__pycache__/**",
        "**/__pycache__/**",
        "src/**",
        "tests/**",
        "test/**",
        ".*",
        ".*/**",
        "local/**",
        "**/*.onnx",
        "**/voice/**"
      ],
      "frontend_assets_lock": "frontend/assets.lock.json",
      "frontend_licenses": "frontend/licenses.json",
      "macos_minimum_version": null
    },
    "macos-x64": {
      "platform": "darwin",
