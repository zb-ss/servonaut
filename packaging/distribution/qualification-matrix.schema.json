{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release qualification matrix",
  "$comment": "scripts/distribution/qualification.py is authoritative. It enforces these rules and what a schema cannot express: every row's family and checks are defined, every defined check and family is used, row ids are unique, extra checks do not repeat family checks, and schema_version is the integer 1 (a schema treats 1.0 as equal to 1). Patterns end in (?!\\n)$ so a trailing newline is refused in both ECMA and Python regular expressions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "failure_link_prefixes", "checks", "families", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "failure_link_prefixes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}/(issues|actions/runs)/(?!\\n)$"
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {"$ref": "#/$defs/check_id"},
      "additionalProperties": {"type": "string", "pattern": "^[ -~]{1,240}(?!\\n)$"}
    },
    "families": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}(?!\\n)$"},
      "additionalProperties": {"$ref": "#/$defs/family"}
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?!\\n)$"},
    "check_list": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/check_id"}
    },
    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,()+-]{0,63}(?!\\n)$"},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "checks"],
      "properties": {
        "title": {"$ref": "#/$defs/label"},
        "checks": {"$ref": "#/$defs/check_list", "minItems": 1}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "family", "artifact_kind", "platform", "arch", "baseline", "extra_checks"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}(?!\\n)$"},
        "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}(?!\\n)$"},
        "artifact_kind": {"enum": ["standalone_cli", "macos_dmg", "windows_msi", "ubuntu_deb"]},
        "platform": {"enum": ["linux", "darwin", "windows"]},
        "arch": {"enum": ["x86_64", "arm64"]},
        "baseline": {"$ref": "#/$defs/label"},
        "extra_checks": {"$ref": "#/$defs/check_list"}
      }
    }
  }
}
