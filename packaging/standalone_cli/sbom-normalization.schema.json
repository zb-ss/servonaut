{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servonaut.dev/schemas/standalone-cli-sbom-normalization-v1.json",
  "title": "Servonaut standalone CLI SBOM normalization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "allowed_http_reference_omissions",
    "allowed_parent_vendors"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "allowed_http_reference_omissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "reference_type", "url_sha256"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+!_-]{0,255}$"
          },
          "reference_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "url_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "allowed_parent_vendors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent", "payload_prefix"],
        "properties": {
          "parent": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 128
          },
          "payload_prefix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$",
            "maxLength": 512
          }
        }
      }
    }
  }
}
