/* Hidden utility class */
.hidden {
    display: none;
}

/* Memory is a record desk: scan context, native records, full-value reader. */
MemoryScreen #memory-container,
FleetMemoryScreen #memory-container {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

MemoryScreen #memory-context,
FleetMemoryScreen #fleet-memory-context {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

MemoryScreen #memory-title,
FleetMemoryScreen #memory-title {
    height: auto;
    margin: 0;
    text-align: left;
    color: $text;
    text-style: bold;
}

MemoryScreen #memory-local-status,
MemoryScreen #memory-shared-source,
FleetMemoryScreen #memory-subtitle,
FleetMemoryScreen #fleet-memory-status,
FleetMemoryScreen #fleet-auto-scan-status {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 0;
    border: none;
    text-align: left;
}

FleetMemoryScreen #memory-subtitle {
    color: $text-muted;
}

MemoryScreen .memory-panel-heading,
FleetMemoryScreen .memory-panel-heading {
    height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
}

MemoryScreen #memory-manage-panel {
    height: auto;
    margin-bottom: 1;
}

MemoryScreen #memory-actions {
    width: 100%;
    height: auto;
}

MemoryScreen #memory-workbench {
    width: 1fr;
    height: 1fr;
    min-height: 15;
}

MemoryScreen #memory-records,
MemoryScreen #memory-record-reader {
    height: 1fr;
    min-height: 12;
    border: round $panel;
    background: $surface;
}

MemoryScreen #memory-records {
    width: 3fr;
}

MemoryScreen #memory-record-reader {
    width: 2fr;
    margin-left: 1;
}

MemoryScreen #memory-record-reader:focus-within {
    border: round $primary;
}

MemoryScreen #memory-table {
    height: 1fr;
    min-height: 8;
    margin: 0;
    background: $surface;
}

MemoryScreen #memory-record-detail {
    height: 1fr;
    min-height: 6;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $text;
}

MemoryScreen #memory-tools {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 0 1;
    width: 1fr;
    height: auto;
    margin-top: 1;
}

MemoryScreen #memory-summary-row,
MemoryScreen #memory-sync-row,
MemoryScreen #memory-ai-row {
    layout: vertical;
    height: auto;
    padding: 0 1;
    border: round $panel;
    background: $surface;
}

MemoryScreen #memory-cloud-banner {
    height: auto;
    margin-top: 1;
}

MemoryScreen #memory-summary-status,
MemoryScreen #memory-sync-status,
MemoryScreen #memory-ai-status,
MemoryScreen #memory-cloud-banner-text {
    width: 1fr;
    height: auto;
    min-height: 1;
    padding: 0;
}

MemoryScreen .memory-row-buttons {
    width: 100%;
    height: auto;
}

MemoryScreen #memory-empty-state {
    height: auto;
    border: round $primary;
    background: $surface;
    margin-bottom: 1;
    padding: 0 1;
}

MemoryScreen #memory-opt-out-banner {
    background: $warning 20%;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
    border: round $warning;
}

MemoryScreen #memory-empty-state-label {
    height: auto;
}

MemoryScreen #memory-hosted-status {
    width: 1fr;
    height: auto;
    padding: 0 1;
    color: $text-muted;
    margin: 0;
    border: none;
    text-align: left;
    content-align: left middle;
}

MemoryScreen.-content-narrow #memory-workbench {
    layout: vertical;
    height: auto;
}

MemoryScreen.-content-narrow #memory-records {
    width: 100%;
    height: 12;
}

MemoryScreen.-content-narrow #memory-record-reader {
    width: 100%;
    height: 12;
    margin: 1 0 0 0;
}

MemoryScreen.-content-narrow #memory-tools {
    grid-size: 1;
    grid-columns: 1fr;
    grid-gutter: 1 0;
}

/* Fleet records get the remaining viewport, with compact controls above. */
FleetMemoryScreen #fleet-memory-table-card {
    height: 1fr;
    min-height: 10;
    margin: 0;
    border: round $panel;
    background: $surface;
}

FleetMemoryScreen #fleet-memory-table {
    height: 1fr;
    margin: 0;
    background: $surface;
}

FleetMemoryScreen #fleet-memory-progress {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

/* Embedded Memory Sync, Drift, and Export tabs inside FleetMemoryScreen. */
FleetMemoryScreen #msync_container,
FleetMemoryScreen #drift-container,
FleetMemoryScreen #export-scroll {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

FleetMemoryScreen #msync_context,
FleetMemoryScreen #drift-context,
FleetMemoryScreen #export-context {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

FleetMemoryScreen #msync_heading_row { height: auto; }
FleetMemoryScreen #msync_title,
FleetMemoryScreen #msync_subtitle,
FleetMemoryScreen #msync_status {
    height: auto;
    margin: 0;
    text-align: left;
}
FleetMemoryScreen #msync_title { width: 1fr; color: $text; text-style: bold; }
FleetMemoryScreen #msync_subtitle { color: $text-muted; max-width: 96; }
FleetMemoryScreen #msync_status { width: auto; max-width: 50%; min-height: 1; text-align: right; }
FleetMemoryScreen #msync_body { height: 1fr; min-height: 6; }
FleetMemoryScreen .msync_card_stack { layout: horizontal; height: auto; width: 1fr; }
FleetMemoryScreen .msync_card {
    border: round $panel;
    background: transparent;
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
    width: 100%;
}
FleetMemoryScreen .msync_card_stack > .msync_card { width: 2fr; }
FleetMemoryScreen .msync_card_stack > .msync_card:first-child { width: 3fr; margin-right: 1; }
FleetMemoryScreen .msync_card_title { height: auto; color: $text; text-style: bold; margin-bottom: 1; }
FleetMemoryScreen .msync_card_body { padding: 0 0 1 0; color: $text; height: auto; }
FleetMemoryScreen .msync_card_warning { color: $text-warning; }
FleetMemoryScreen .msync_card_actions {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
    align: left middle;
    padding: 0;
}
FleetMemoryScreen .msync_card_actions Button {
    width: 1fr;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 0;
    min-width: 0;
}
FleetMemoryScreen .msync_benefits { height: auto; padding: 0 0 1 0; }
FleetMemoryScreen .msync_benefit_row { height: auto; color: $text; }
FleetMemoryScreen .msync_kv_grid { height: auto; }
FleetMemoryScreen .msync_kv_row {
    height: auto;
    layout: horizontal;
    padding: 0 1;
    margin-bottom: 1;
    background: $boost;
}
FleetMemoryScreen .msync_kv_label { width: 18; height: auto; color: $text-muted; }
FleetMemoryScreen .msync_kv_value { width: 1fr; height: auto; color: $text; }
FleetMemoryScreen .msync_configured_actions { layout: vertical; }
FleetMemoryScreen.-content-narrow .msync_card_stack { layout: vertical; }
FleetMemoryScreen.-content-narrow .msync_card_stack > .msync_card,
FleetMemoryScreen.-content-narrow .msync_card { width: 100%; margin-right: 0; }
FleetMemoryScreen.-content-narrow .msync_card_actions { layout: vertical; }

FleetMemoryScreen .memory-secondary-heading {
    width: 1fr;
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
}
FleetMemoryScreen #drift-container { overflow-y: auto; }
FleetMemoryScreen #drift-filter-label { height: auto; margin: 0; }
FleetMemoryScreen #drift-records {
    height: 1fr;
    min-height: 10;
    border: round $panel;
    background: transparent;
}
FleetMemoryScreen #drift-table { height: 1fr; background: $surface; }
FleetMemoryScreen #drift-tools { height: auto; margin-bottom: 1; }
FleetMemoryScreen #drift-actions { width: 100%; height: auto; }
FleetMemoryScreen #drift-empty-state { height: auto; padding: 1; color: $text-muted; }

FleetMemoryScreen #export-container { padding: 0 1; width: 1fr; height: auto; }
FleetMemoryScreen #export-description { height: auto; max-width: 96; margin: 0; }
FleetMemoryScreen #export-workspace { height: auto; min-height: 16; }
FleetMemoryScreen #export-range-panel,
FleetMemoryScreen #export-result-panel {
    height: auto;
    min-height: 16;
    border: round $panel;
    background: transparent;
}
FleetMemoryScreen #export-range-panel { width: 2fr; margin-right: 1; }
FleetMemoryScreen #export-result-panel { width: 3fr; }
FleetMemoryScreen #export-date-fields { layout: vertical; height: auto; padding: 1 1 0 1; }
FleetMemoryScreen .export-field-row { width: 1fr; height: auto; margin-bottom: 1; }
FleetMemoryScreen #export-status { height: auto; min-height: 3; padding: 1 1; }
FleetMemoryScreen #export-btn-row { width: 100%; height: auto; padding: 0 1; }
FleetMemoryScreen #export-btn-row Button {
    width: auto;
    min-width: 16;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 0 2;
}
FleetMemoryScreen.-content-narrow #export-workspace { layout: vertical; }
FleetMemoryScreen.-content-narrow #export-range-panel,
FleetMemoryScreen.-content-narrow #export-result-panel { width: 100%; margin-right: 0; }
FleetMemoryScreen.-content-narrow #export-range-panel { margin-bottom: 1; }
FleetMemoryScreen.-content-narrow #export-result-panel { min-height: 8; }
