/* ===================================================================
   Servonaut v2.0 - Professional TUI Theme
   =================================================================== */

/* ===================================================================
   GLOBAL STYLES & RESETS
   =================================================================== */

* {
    scrollbar-background: transparent;
    /* The square where two scrollbars meet takes the screen surface, not black. */
    scrollbar-corner-color: $surface;
    scrollbar-color: $panel-lighten-2;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $accent;
}

Screen {
    background: $surface;
}

/* Keep native slider fills distinct from both the track and themed surfaces. */
Switch .switch--slider {
    color: $text-muted;
}

Switch:hover .switch--slider {
    color: $text;
}

Switch.-on .switch--slider {
    color: $success;
}

Switch.-on:hover .switch--slider {
    color: $success-lighten-1;
}

/* The native right position identifies ON when light themes need neutral fills. */
Switch:light.-on .switch--slider {
    color: $text;
}

Switch:light.-on:hover .switch--slider {
    color: $text-muted;
}

/* Explicit terminal roles retain hover feedback without relying on ANSI alpha.
   Keep these after the light-theme rules so ANSI state colors win ties. */
Switch:ansi .switch--slider {
    color: ansi_bright_black;
}

Switch:ansi:hover .switch--slider {
    color: ansi_default;
}

Switch:ansi.-on .switch--slider {
    color: $success;
}

Switch:ansi.-on:hover .switch--slider {
    color: ansi_bright_green;
}

/* A visible native frame keeps the slider's left/right position readable. */
Switch:ansi:enabled:blur {
    border: tall $foreground;
}

/* Global default: every ModalScreen centres its dialog. Individual modals
   can still override with a higher-specificity (#id) rule, but this makes
   centred the baseline so a new modal is never stranded in the top-left.
   Textual type selectors match base classes, so this hits all subclasses.

   The `Screen` rule above matches modals too and would paint them opaque,
   hiding the screen the dialog belongs to. Restore Textual's own modal
   backdrop (the one the command palette uses): the screen behind stays
   visible, dimmed. This rule must stay after the `Screen` rule, which it
   ties with on specificity. Dialog containers set their own background. */
ModalScreen {
    align: center middle;
    background: $background 60%;

    &:ansi {
        background: transparent;
    }
}

/* Dialog boxes built from a plain Vertical. Their DEFAULT_CSS gives them the
   surface colour, but the app-wide `Vertical { background: transparent }`
   rule wins over any DEFAULT_CSS, so without this the dimmed backdrop would
   show through the dialog itself. */
#copy-mode-container,
#text-editor-container {
    background: $surface;
}

/* ===================================================================
   HEADER & FOOTER
   =================================================================== */

Header {
    background: $surface;
    color: $text;
    text-style: bold;
    dock: top;
}

Header:ansi {
    background: $panel;
    color: $foreground;
}

Header HeaderTitle {
    color: auto 100%;
}

Header:ansi HeaderTitle {
    color: $foreground;
}

Footer {
    background: $panel;
    color: $text-muted;
    dock: bottom;
    height: 2;
    border-top: wide $primary;
}

/* Light themes may pair their native footer text with an accent fill. Our
   quiet panel needs its own text role, including native binding components. */
Footer:light,
Footer:light FooterLabel,
Footer:light FooterKey .footer-key--key,
Footer:light FooterKey .footer-key--description {
    color: $text;
}

/* ===================================================================
   BUTTONS - Global Styling
   =================================================================== */

Button {
    min-width: 16;
    height: 3;
    background: transparent;
    color: $text;
    border: round $primary 65%;
    text-align: center;
    content-align: center middle;
}

Button.-primary {
    color: $text-accent;
    border: round $primary;
}

Button.-success {
    color: $text-success;
    border: round $success;
}

Button.-warning {
    color: $text-warning;
    border: round $warning;
}

Button.-error {
    color: $text-error;
    border: round $error;
}

Button:hover {
    background: transparent;
    color: $text-accent;
    border: round $accent;
    text-style: bold;
}

Button:focus {
    background: transparent;
    color: $text-accent;
    border: round $accent;
    text-style: bold underline;
}

Button.-warning:hover,
Button.-warning:focus {
    background: transparent;
    color: $text-warning;
    border: round $warning;
    text-style: bold underline;
}

Button.-error:hover,
Button.-error:focus {
    background: transparent;
    color: $text-error;
    border: round $error;
    text-style: bold underline;
}

#btn_back {
    background: transparent;
    color: $text-muted;
    border: round $border-blurred;
}

#btn_back:hover {
    background: transparent;
    color: $text;
    border: round $accent;
    text-style: bold;
}

#btn_back:focus {
    background: transparent;
    color: $text-accent;
    border: round $accent;
    text-style: bold underline;
}

Button.-primary:ansi,
Button.-success:ansi,
Button.-warning:ansi,
Button.-error:ansi,
#btn_back:ansi {
    color: $foreground;
}

Button:ansi:hover,
Button.-primary:ansi:hover,
Button.-success:ansi:hover,
Button.-warning:ansi:hover,
Button.-error:ansi:hover,
#btn_back:ansi:hover {
    background: $surface;
    color: $foreground;
    border: round $accent;
    text-style: underline not bold;
}

Button:ansi:focus,
Button.-primary:ansi:focus,
Button.-success:ansi:focus,
Button.-warning:ansi:focus,
Button.-error:ansi:focus,
#btn_back:ansi:focus {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    border: round $warning;
    text-style: not bold;
}

Button:ansi:disabled:hover,
Button.-primary:ansi:disabled:hover,
Button.-success:ansi:disabled:hover,
Button.-warning:ansi:disabled:hover,
Button.-error:ansi:disabled:hover,
#btn_back:ansi:disabled:hover {
    text-style: not underline not bold;
}

/* ===================================================================
   INPUT FIELDS - Global Styling
   =================================================================== */

Input {
    background: transparent;
    border: round $primary-background;
    padding: 0 1;
}

Input:focus {
    border: round $accent;
    background: transparent;
}

Input.-invalid {
    border: round $error;
}

/* Keep the selected label readable on the theme's native cursor fill. */
SelectOverlay:focus > .option-list--option-highlighted {
    color: auto 100%;
}

/* Terminal palettes retain their explicit native foreground/background pair. */
SelectOverlay:ansi:focus > .option-list--option-highlighted {
    color: $block-cursor-foreground;
}

/* Native ANSI selections reverse the terminal's readable foreground pair. */
TextArea:ansi .text-area--selection {
    color: $foreground;
}

/* Keep native editor edges visible when focus moves away. */
CopyModeScreen #copy-mode-text:ansi:enabled:blur,
TextEditorModal #text-editor-area:ansi:enabled:blur,
CustomServersScreen #input_extra_ssh_options:ansi:enabled:blur,
BugReportScreen #description:ansi:enabled:blur {
    border: tall $foreground;
}

/* ===================================================================
   DATA TABLES - Global Styling
   =================================================================== */

DataTable {
    background: transparent;
    color: $text;
    border: none;
    height: auto;
}

DataTable > .datatable--header {
    background: $primary;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $surface;
    color: auto 100%;
    text-style: bold reverse;
}

DataTable:focus > .datatable--cursor {
    background: $surface;
    color: auto 100%;
}

DataTable:ansi > .datatable--header {
    background: $panel;
    color: $foreground;
}

DataTable:ansi > .datatable--cursor,
DataTable:ansi:focus > .datatable--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: not bold;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--even-row {
    background: $boost;
}

/* ===================================================================
   SHARED FORM CLASSES — used across settings, key management,
   server setup screens, and any screen with .setting_row / .note /
   .section_header widgets.
   =================================================================== */

.section_header {
    padding: 1 0;
    margin-top: 2;
    color: $accent;
    text-style: bold;
    border-bottom: wide $primary;
}

.setting_row {
    layout: horizontal;
    height: auto;
    margin: 1 0;
    align: left middle;
}

.setting_row .label {
    width: 30;
    padding: 0 2 0 0;
    text-align: right;
    color: $text-muted;
}

.setting_row Input,
.setting_row SecretInput {
    width: 1fr;
    margin-right: 1;
}

.setting_row Button {
    width: auto;
    min-width: 12;
}

.note {
    padding: 0 1 1 1;
    color: $text-muted;
    text-style: italic;
}

