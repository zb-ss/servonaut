/* ===================================================================
   RESPONSIVE ADJUSTMENTS
   Textual does not support @media queries — using max-width directly
   on containers instead for reasonable defaults.
   =================================================================== */

/* ===================================================================
   MODERN DASHBOARD & SIDEBAR STYLES
   =================================================================== */

#main-layout {
    height: 100%;
    align: left top;
}

/* --- Sidebar --- */
/* Sidebar uses DEFAULT_CSS in sidebar.py for base layout.
   These rules style its direct children (flat, no nested containers). */

/* sidebar-spacer + sidebar-section-title removed in the Sidebar
   redesign — sections now own their headers (see widgets/sidebar_section.py)
   and the bottom row is dock-bottomed via #sidebar-bottom (see Sidebar
   DEFAULT_CSS). */

.nav-button {
    width: 100%;
    height: 3;
    border: none;
    background: transparent;
    content-align: left middle;
    padding: 0 1;
    margin: 0;
}

.nav-button:hover {
    background: $boost;
    text-style: none;
    border: none;
}

.nav-button:focus {
    background: $boost;
    border: none;
    text-style: bold;
}

.nav-button.--active {
    background: $primary 30%;
    text-style: bold;
    color: $accent;
}

.nav-button.--active:focus {
    background: $primary;
    color: $accent;
    text-style: bold;
}

/* Terminal palettes do not blend ANSI fills; reverse keeps route text legible. */
.nav-button.--active:ansi {
    background: $background;
    color: $text;
    text-style: bold reverse;
}

.nav-button:focus:ansi {
    text-style: bold underline;
}

.nav-button.--active:focus:ansi {
    background: $background;
    color: $text;
    text-style: bold underline reverse;
}

.error-button {
    color: $error;
    margin-top: 1;
}

.error-button:hover {
    background: $error 15%;
}

.error-button:focus {
    background: $error;
}

/* --- Dashboard Main Content --- */

#dashboard-content {
    height: 100%;
    padding: 2 4;
    background: $surface;
    overflow-y: auto;
}

#dashboard-header {
    height: auto;
    margin-bottom: 2;
}

#dashboard-title {
    text-align: left;
}

#dashboard-subtitle {
    color: $text-muted;
    text-align: left;
}

/* --- Stats Row --- */

#stats-row {
    height: 6;
    margin-bottom: 2;
}

.stat-card {
    width: 1fr;
    height: 100%;
    background: transparent;
    border: round $border-blurred;
    content-align: center middle;
    text-align: center;
    margin-right: 2;
    padding: 1;
}

/* --- Actions Grid --- */

#actions-grid {
    grid-size: 3;
    grid-rows: auto;
    grid-columns: 1fr;
    grid-gutter: 2;
    height: auto;
}

MainMenuScreen.-content-narrow #actions-grid {
    grid-size: 2;
}

.action-card {
    width: 100%;
    height: auto;
    min-height: 6;
    background: transparent;
    border: round $primary 40%;
    content-align: center middle;
    text-align: center;
    padding: 1;
}

.action-card:hover {
    background: transparent;
    border: round $accent;
}

.action-card:focus {
    background: transparent;
    border: round $accent;
    text-style: bold;
}
