/* Dialog presentation is shared; each ModalScreen owns its interactions. */
$dialog-notification-height: 4;

.dialog-screen {
    align: center middle;
    background: $background 60%;
}

.dialog-screen:ansi { background: transparent; }

/* Reserve the same room throughout the modal's lifetime, so notifications
   appearing or expiring never move a confirmation target under the pointer. */
.dialog-screen > DialogNotificationSpace {
    dock: bottom;
    height: $dialog-notification-height;
    margin-bottom: 2;
    visibility: hidden;
}

/* Native toasts overlay only the reserved lane and keep their own lifecycle.
   Keep its capped rack scrollable and the screen's two-row footer clear. */
.dialog-screen > ToastRack {
    max-height: $dialog-notification-height;
    overflow-y: auto;
    margin-bottom: 2;
    visibility: visible;
}

/* A title and three message rows fit the lane; longer alerts scroll natively. */
.dialog-screen Toast { padding: 0 1; margin-top: 0; }

DialogFrame {
    width: 76;
    max-width: 94%;
    height: 26;
    max-height: 90%;
    padding: 1 2;
    background: transparent;
    border: round $border-blurred;
}

DialogFrame.dialog-compact { width: 68; height: auto; max-height: 18; }
DialogFrame.dialog-standard { height: auto; }
DialogFrame.dialog-large { width: 86; height: 32; }
DialogFrame.dialog-fill { width: 90%; height: 85%; }
DialogFrame.dialog-neutral {
    border: round $foreground-muted;
    border-subtitle-color: $foreground-muted;
}
DialogFrame.dialog-warning { border: round $warning; }
DialogFrame.dialog-warning:ansi:light { border-subtitle-color: $foreground; }
DialogFrame.dialog-danger { border: round $error; }

DialogFrame > .dialog-heading {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
    color: $text;
}

DialogFrame > .dialog-body {
    width: 100%;
    height: 1fr;
    min-height: 1;
    margin-bottom: 1;
    background: transparent;
    overflow-x: hidden;
}

DialogFrame .dialog-body Static { height: auto; }
DialogFrame > DialogContent { overflow: hidden hidden; }
DialogFrame .dialog-description { margin-bottom: 1; }
DialogFrame .dialog-muted { color: $text-muted; }
DialogFrame .dialog-consequence { padding-left: 2; }
DialogFrame .dialog-emphasis { text-style: bold; margin-top: 1; }

/* Keep short destructive-action details readable beside the pinned warning. */
DialogFrame.dialog-danger > .dialog-heading,
DialogFrame.dialog-danger .dialog-description { margin-bottom: 0; }

DialogFrame > .dialog-footer {
    height: auto;
    background: transparent;
}

DialogFrame > .dialog-footer > .dialog-status {
    height: auto;
    background: transparent;
}

DialogFrame .dialog-status .dialog-emphasis { margin-top: 0; }
DialogFrame .dialog-status Static { height: auto; }
DialogFrame .dialog-status Input {
    width: 100%;
    height: 3;
    margin: 0;
    background: transparent;
    border: round $border-blurred;
}

DialogFrame .dialog-status Input:focus { border: round $accent; }

DialogFrame > .dialog-footer > DialogActions {
    width: 100%;
    height: 3;
    align: right middle;
    background: transparent;
}

DialogFrame > .dialog-footer > DialogActions > Button {
    width: auto;
    min-width: 12;
    max-width: 48%;
    height: 3;
    margin-left: 1;
    background: transparent;
    color: $text;
    border: round $border-blurred;
}

DialogFrame > .dialog-footer > DialogActions > Button:hover {
    background: transparent;
    border: round $accent;
}

DialogFrame > .dialog-footer > DialogActions > Button.-warning {
    background: transparent;
    color: auto 100%;
    border: round $warning;
}

DialogFrame > .dialog-footer > DialogActions > Button.-error {
    background: transparent;
    color: auto 100%;
    border: round $error;
}

DialogFrame > .dialog-footer > DialogActions > Button:focus {
    background: transparent;
    text-style: bold underline;
    border: round $accent;
}

/* Default variants may have no class; terminal cues must cover them too. */
DialogFrame > .dialog-footer > DialogActions > Button:ansi:enabled:blur {
    border: round $foreground;
}

DialogFrame > .dialog-footer > DialogActions > Button:ansi:enabled:hover {
    background: $surface;
    color: $foreground;
    border: round $accent;
    text-style: bold underline;
}

DialogFrame > .dialog-footer > DialogActions > Button:ansi:enabled:focus {
    background: $surface;
    color: $foreground;
    border: round $accent;
    text-style: bold underline reverse;
}

DialogFrame > .dialog-footer > DialogActions > Button.-active:ansi:enabled {
    background: $surface;
    color: $foreground;
    border: blank $background;
    tint: transparent;
    text-style: bold underline reverse;
}

/* Severity outlines retain their roles above the shared terminal cues. */
DialogFrame > .dialog-footer > DialogActions > Button.-warning:ansi:enabled:blur {
    border: round $warning;
}

DialogFrame > .dialog-footer > DialogActions > Button.-error:ansi:enabled:blur {
    border: round $error;
}

/* Terminal fills do not blend; preserve the terminal's default text pair. */
DialogFrame > .dialog-footer > DialogActions > Button.-warning:ansi,
DialogFrame > .dialog-footer > DialogActions > Button.-error:ansi {
    background: $surface;
    color: $foreground;
}

DialogFrame > .dialog-footer > DialogActions > Button.-warning:ansi:enabled:hover,
DialogFrame > .dialog-footer > DialogActions > Button.-error:ansi:enabled:hover {
    text-style: bold underline;
}

DialogFrame > .dialog-footer > DialogActions > Button.-warning:ansi:enabled:focus,
DialogFrame > .dialog-footer > DialogActions > Button.-error:ansi:enabled:focus {
    text-style: bold underline reverse;
}

/* Preserve pressed feedback without tinting readable text into its surface. */
DialogFrame > .dialog-footer > DialogActions > Button.-warning.-active:enabled,
DialogFrame > .dialog-footer > DialogActions > Button.-error.-active:enabled {
    tint: transparent;
    text-style: bold underline reverse;
}

DialogFrame > .dialog-footer > DialogActions > Button.-warning.-active:ansi:enabled,
DialogFrame > .dialog-footer > DialogActions > Button.-error.-active:ansi:enabled {
    border: blank $background;
}

DialogFrame > .dialog-footer > DialogActions > Button:disabled { opacity: 50%; }

/* Prompts fit their content until the cap; only the body scrolls. */
DialogFrame.dialog-compact > .dialog-heading,
DialogFrame.dialog-standard > .dialog-heading { dock: top; }
DialogFrame.dialog-compact > .dialog-footer,
DialogFrame.dialog-standard > .dialog-footer { dock: bottom; }
DialogFrame.dialog-compact > .dialog-body,
DialogFrame.dialog-standard > .dialog-body { height: auto; max-height: 100%; }

/* A dialog screen that declares these vertical breakpoints (below 24 rows is
   -dialog-minimal, 24 to 39 is -dialog-tight) trades spacing for room, so its
   content and actions both stay on a short terminal. Standard dialogs keep
   their padding and size cap down to -dialog-tight. */
.dialog-screen.-dialog-minimal > DialogFrame {
    padding: 0 2;
    max-height: 100%;
}

.dialog-screen.-dialog-minimal > DialogFrame > .dialog-heading,
.dialog-screen.-dialog-tight > DialogFrame > .dialog-heading { margin-bottom: 0; }

/* Toasts then overlay the dialog's top instead of reserving a lane that the
   dialog needs, which keeps them clear of the actions. */
.dialog-screen.-dialog-minimal > DialogNotificationSpace,
.dialog-screen.-dialog-tight > DialogNotificationSpace { display: none; }

.dialog-screen.-dialog-minimal > ToastRack,
.dialog-screen.-dialog-tight > ToastRack {
    dock: top;
    align: right top;
    margin: 0;
}

/* Keep confirmation copy readable; outlines and actions carry severity. */
ConfirmActionScreen #modal_title,
ConfirmActionScreen .consequence_item,
ConfirmActionScreen #severity_message {
    color: auto 100%;
}

ConfirmActionScreen #modal_title:ansi,
ConfirmActionScreen .consequence_item:ansi,
ConfirmActionScreen #severity_message:ansi {
    color: $foreground;
}

/* Tool approvals: the model's arguments scroll in a box of their own, so a
   long value can never hide its tail. The cue below the box keeps its row
   (it is hidden, not removed) so scrolling never moves the layout. */
DialogFrame .dialog-body .dialog-arg-scroll {
    height: auto;
    max-height: 12;
}

DialogFrame.dialog-danger .dialog-body .dialog-arg-scroll { max-height: 10; }

DialogFrame .dialog-body .dialog-scroll-cue {
    height: 1;
    color: $text-warning;
    display: none;
}

.dialog-screen.-dialog-minimal DialogFrame .dialog-body .dialog-arg-scroll { max-height: 4; }
