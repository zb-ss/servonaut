/* ===================================================================
   SCREEN HEADER
   One header look for every screen: a bold title, a muted description under
   it, no side inset beyond the container's own, no bar or accent colour. A
   status, if the screen has one, sits right-aligned on the title row. The
   title keeps one empty row above it so it never touches the top of the
   content area.
   =================================================================== */

.screen-title {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text;
    text-align: left;
    text-style: bold;
}

.screen-description {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    text-align: left;
}

.screen-status {
    width: auto;
    height: auto;
    margin: 1 0 0 1;
    padding: 0;
    color: $text-muted;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
