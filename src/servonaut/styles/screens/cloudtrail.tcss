/* ===================================================================
   CLOUDTRAIL BROWSER SCREEN
   =================================================================== */

#cloudtrail_container {
    width: 1fr;
    height: 100%;
}

#cloudtrail_title {
    margin: 0 1 0 1;
}

#cloudtrail_filters {
    height: auto;
    max-height: 7;
    padding: 0 1;
    background: $boost;
    border: round $primary;
    margin: 0 1;
}

#cloudtrail_filters Vertical {
    width: 1fr;
    height: auto;
    margin: 0 1;
}

#ct_filter_region {
    width: 2fr;
}

#cloudtrail_filters Select {
    height: 3;
}

/* Event names run long ("UpdateInstanceInformation"); let the open list
   size to its content instead of wrapping inside a narrow column. */
#cloudtrail_filters Select SelectOverlay {
    width: auto;
    max-width: 46;
}

#cloudtrail_filters Button {
    margin: 1 0 0 1;
}

#cloudtrail_table {
    height: 1fr;
    margin: 0 1;
}

#cloudtrail_pager {
    height: auto;
    align: center middle;
    padding: 0 1;
    margin: 0 1;
}

#cloudtrail_pager Button {
    margin: 0 1;
}

#ct_page_info {
    content-align: center middle;
    width: 1fr;
    text-align: center;
}

#event_detail {
    height: auto;
    max-height: 25%;
    padding: 1;
    margin: 0 1 1 1;
    background: $panel;
    border: round $accent;
    overflow-y: auto;
}


/* Typed filter value — reachable when a value sits further back in the
   window than the loaded events. */
#ct_value_modal {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#ct_value_modal_title {
    margin-bottom: 1;
}

#ct_value_modal_hint {
    margin-bottom: 1;
}

#ct_value_input {
    margin-bottom: 1;
}

#ct_value_modal_buttons {
    height: auto;
    align-horizontal: right;
}

#btn_ct_value_ok, #btn_ct_value_cancel {
    margin-left: 1;
}
