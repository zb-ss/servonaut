/* CloudTrail: compact query controls and a persistent selected-event inspector. */

#cloudtrail_container {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: auto;
}

#cloudtrail_heading {
    height: auto;
}

#cloudtrail_filters {
    layout: grid;
    grid-size: 6 1;
    grid-columns: 3fr 19 2fr 2fr 2fr 34;
    min-width: 102;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    padding: 0 1;
    background: $panel;
    border: none;
    margin-bottom: 1;
}

#cloudtrail_filters Vertical {
    width: 100%;
    height: auto;
}

#cloudtrail_filters Label {
    width: 100%;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#cloudtrail_filters Select {
    width: 100%;
    height: 3;
}

#cloudtrail_filters SelectCurrent {
    padding: 0 1;
}

#cloudtrail_filters SelectCurrent Static#label {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#cloudtrail_filters Select SelectOverlay {
    width: auto;
    min-width: 100%;
    max-width: 46;
}

/* Fetch and Back keep their natural width and line up with the controls. */
#ct_filter_actions {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_filters {
    grid-size: 6 2;
    grid-columns: 1fr;
    min-width: 61;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_filters Vertical {
    column-span: 2;
}

CloudTrailBrowserScreen.-content-narrow #ct_filter_actions {
    width: 100%;
    column-span: 2;
}

/* The account picker adds a control, so the filters always take two rows. */
#cloudtrail_filters.-with-account {
    grid-size: 4 2;
    grid-columns: 1fr 1fr 19 1fr;
    min-width: 51;
}

#cloudtrail_filters.-with-account #ct_filter_actions {
    column-span: 2;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_filters.-with-account {
    grid-size: 4 2;
    grid-columns: 1fr 1fr 19 1fr;
    min-width: 51;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_filters.-with-account Vertical {
    column-span: 1;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_filters.-with-account #ct_filter_actions {
    column-span: 2;
}

#cloudtrail_workspace {
    height: 1fr;
    min-height: 10;
}

#cloudtrail_results {
    width: 3fr;
    height: 100%;
    min-height: 7;
    margin-right: 1;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: transparent;
}

#cloudtrail_results:focus-within {
    border: round $accent;
    border-title-color: $text-accent;
}

#cloudtrail_table {
    height: 1fr;
    border: none;
}

#cloudtrail_pager {
    height: auto;
    align: center middle;
    padding: 0 1;
    background: $panel;
}


#ct_page_info {
    height: auto;
    width: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
}

#event_detail {
    width: 2fr;
    height: 100%;
    min-height: 6;
    padding: 0 1;
    background: transparent;
    border: round $border-blurred;
    border-title-color: $text-muted;
    overflow-y: auto;
}

#event_detail_text {
    height: auto;
    width: 100%;
}

#event_detail:focus-within {
    border: round $accent;
    border-title-color: $text-accent;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_workspace {
    layout: vertical;
    min-height: 14;
}

CloudTrailBrowserScreen.-content-narrow #cloudtrail_results {
    width: 100%;
    height: 3fr;
    margin: 0 0 1 0;
}

CloudTrailBrowserScreen.-content-narrow #event_detail {
    width: 100%;
    height: 2fr;
}

CloudTrailBrowserScreen.-short #cloudtrail_heading {
    margin-bottom: 0;
}

