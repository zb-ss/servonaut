/* ===================================================================
   CLOUDTRAIL BROWSER SCREEN
   =================================================================== */

#cloudtrail_container {
    width: 1fr;
    height: 100%;
}

#cloudtrail_title {
    margin: 0 1 0 1;
}

#cloudtrail_filters {
    height: auto;
    max-height: 7;
    padding: 0 1;
    background: $boost;
    border: round $primary;
    margin: 0 1;
}

#cloudtrail_filters Vertical {
    width: 1fr;
    height: auto;
    margin: 0 1;
}

#ct_filter_region {
    width: 2fr;
}

#cloudtrail_filters Select {
    height: 3;
}

#cloudtrail_filters Button {
    margin: 1 0 0 1;
}

#cloudtrail_table {
    height: 1fr;
    margin: 0 1;
}

#cloudtrail_pager {
    height: auto;
    align: center middle;
    padding: 0 1;
    margin: 0 1;
}

#cloudtrail_pager Button {
    margin: 0 1;
}

#ct_page_info {
    content-align: center middle;
    width: 1fr;
    text-align: center;
}

#event_detail {
    height: auto;
    max-height: 25%;
    padding: 1;
    margin: 0 1 1 1;
    background: $panel;
    border: round $accent;
    overflow-y: auto;
}

