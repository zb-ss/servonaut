/* CloudWatch: query controls above an event list and investigation rail. */

#cloudwatch_outer {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
}

#cloudwatch_heading {
    height: auto;
}

#cloudwatch_filter_bar {
    layout: grid;
    grid-size: 5 1;
    grid-columns: 3fr 3fr 22 2fr 34;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    padding: 0 1;
    background: $panel;
    border: none;
    margin-bottom: 1;
}

#cloudwatch_filter_bar Vertical {
    width: 100%;
    height: auto;
}

#cloudwatch_filter_bar Label {
    width: 100%;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#cloudwatch_filter_bar SelectCurrent {
    padding: 0 1;
}

#cloudwatch_filter_bar SelectCurrent Static#label {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#cloudwatch_filter_bar SelectOverlay {
    width: auto;
    min-width: 100%;
    max-width: 64;
}

/* Fetch and Back keep their natural width and line up with the controls. */
#cw_filter_actions {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

CloudWatchBrowserScreen.-content-narrow #cloudwatch_filter_bar {
    grid-size: 4 2;
    grid-columns: 6fr 8fr 12 12;
}

CloudWatchBrowserScreen.-content-narrow #cw_filter_time_range {
    column-span: 2;
}

CloudWatchBrowserScreen.-content-narrow #cw_filter_pattern {
    column-span: 2;
}

CloudWatchBrowserScreen.-content-narrow #cw_filter_actions {
    width: 100%;
    column-span: 2;
}

#cloudwatch_filter_bar.-with-account {
    grid-size: 6 1;
    grid-columns: 18 3fr 3fr 22 2fr 34;
}

CloudWatchBrowserScreen.-content-narrow #cloudwatch_filter_bar.-with-account {
    grid-size: 5 2;
    grid-columns: 16 6fr 8fr 12 12;
}

CloudWatchBrowserScreen.-content-narrow #cloudwatch_filter_bar.-with-account #cw_filter_pattern {
    column-span: 3;
}

#cw_filter_account > Select {
    width: 100%;
}

#cloudwatch_main_content {
    height: 1fr;
    min-height: 16;
}

#cloudwatch_events_panel {
    width: 1fr;
    height: 100%;
    border: round $border-blurred;
    border-title-color: $text-muted;
    margin-right: 1;
    background: transparent;
}

#cloudwatch_events_panel:focus-within {
    border: round $accent;
    border-title-color: $text-accent;
}

#cloudwatch_events_table {
    width: 1fr;
    height: 1fr;
    border: none;
}

#cloudwatch_inspector {
    width: 45;
    height: 100%;
}

CloudWatchBrowserScreen.-content-narrow #cloudwatch_inspector {
    width: 33;
}

#cloudwatch_ips_panel {
    width: 100%;
    height: 2fr;
    min-height: 8;
    border: round $border-blurred;
    border-title-color: $text-muted;
    padding: 0 1;
    background: transparent;
    margin-bottom: 1;
}

#cloudwatch_ips_panel:focus-within {
    border: round $accent;
    border-title-color: $text-accent;
}

#cw_top_ips_header {
    height: 1;
    width: 100%;
}

#cw_top_ips_label {
    width: 1fr;
    color: $text;
}

#cw_btn_ip_filter {
    margin: 0;
}

#cloudwatch_ips_table {
    height: 1fr;
    min-height: 2;
    border: none;
}

#cloudwatch_pager {
    height: auto;
    align: center middle;
    padding: 0 1;
    background: $panel;
}

#cw_page_controls {
    width: 100%;
    height: auto;
    align: center middle;
}

#cw_page_info {
    width: 100%;
    height: auto;
    content-align: center middle;
    text-align: center;
    text-wrap: wrap;
    color: $text-muted;
}

#cw_btn_ban_ip {
    margin-top: 1;
}

#cloudwatch_detail {
    width: 100%;
    height: 3fr;
    min-height: 6;
    padding: 0 1;
    background: transparent;
    border: round $border-blurred;
    border-title-color: $text-muted;
    overflow-y: auto;
}

#cloudwatch_detail_text {
    height: auto;
    width: 100%;
}

#cloudwatch_detail:focus-within {
    border: round $accent;
    border-title-color: $text-accent;
}

CloudWatchBrowserScreen.-short #cloudwatch_heading {
    margin-bottom: 0;
}

CloudWatchBrowserScreen.-short #cloudwatch_pager ActionButton,
CloudWatchBrowserScreen.-short #cw_btn_ban_ip {
    margin: 0;
}


/* Fit the short workspace without sacrificing loaded event/IP rows.
   The IP table keeps its header, one row and a horizontal scrollbar. */
CloudWatchBrowserScreen.-short #cloudwatch_filter_bar {
    margin-bottom: 0;
}

CloudWatchBrowserScreen.-short #cloudwatch_main_content {
    min-height: 12;
}

CloudWatchBrowserScreen.-short #cloudwatch_events_table {
    min-height: 4;
}

CloudWatchBrowserScreen.-short #cloudwatch_ips_panel {
    height: 7;
    min-height: 7;
    margin-bottom: 0;
}

CloudWatchBrowserScreen.-short #cloudwatch_detail {
    min-height: 5;
}
