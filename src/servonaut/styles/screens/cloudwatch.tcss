/* ===================================================================
   CLOUDWATCH BROWSER SCREEN
   =================================================================== */

#cloudwatch_outer {
    width: 1fr;
    height: 100%;
}

#cloudwatch_title {
    margin: 0 1 0 1;
}

#cloudwatch_filter_bar {
    height: auto;
    max-height: 7;
    padding: 0 1;
    background: $boost;
    border: round $primary;
    margin: 0 1;
}

#cloudwatch_filter_bar Vertical {
    width: 1fr;
    height: auto;
    margin: 0 1;
}

#cw_filter_region {
    width: 2fr;
}

#cw_filter_log_group {
    width: 3fr;
}

#cloudwatch_filter_bar Select {
    height: 3;
}

#cloudwatch_filter_bar Button {
    margin: 1 0 0 1;
}

#cloudwatch_main_content {
    height: 1fr;
    margin: 0 1;
}

#cloudwatch_events_table {
    width: 3fr;
    height: 100%;
    border: round $primary;
    margin: 0 1 0 0;
}

#cloudwatch_ips_panel {
    width: 1fr;
    height: 100%;
    border: round $accent;
    padding: 1;
    background: $boost;
}

#cw_top_ips_header {
    height: 1;
    width: 100%;
    align: center middle;
}

#cw_top_ips_label {
    width: 1fr;
    text-align: center;
    color: $accent;
}

#cw_btn_ip_filter {
    width: auto;
    min-width: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    padding: 0 1;
    margin: 0;
    height: 1;
}

#cloudwatch_ips_table {
    height: 100%;
    border: round $primary;
}

#cloudwatch_pager {
    height: auto;
    align: center middle;
    padding: 0 1;
    margin: 0 1;
}

#cloudwatch_pager Button {
    margin: 0 1;
}

#cw_page_info {
    content-align: center middle;
    width: 1fr;
    text-align: center;
}

#cloudwatch_ips_panel Button {
    width: 100%;
    margin-top: 1;
}

#cloudwatch_detail {
    height: auto;
    max-height: 25%;
    padding: 1;
    margin: 0 1 1 1;
    background: $panel;
    border: round $accent;
    overflow-y: auto;
}

