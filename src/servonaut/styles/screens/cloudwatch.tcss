/* ===================================================================
   CLOUDWATCH BROWSER SCREEN
   =================================================================== */

#cloudwatch_outer {
    width: 1fr;
    height: 100%;
}

#cloudwatch_title {
    margin: 0 1 0 1;
}

/* The filters sit on one grid row when the terminal is wide enough for
   every placeholder to fit (the screen's -wide class) and wrap onto two
   rows otherwise (-narrow, below). */
#cloudwatch_filter_bar {
    layout: grid;
    grid-size: 6 1;
    grid-columns: 3fr 3fr 22 2fr 10 10;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    padding: 0 1;
    background: $boost;
    border: round $primary;
    margin: 0 1;
}

#cloudwatch_filter_bar Vertical {
    width: 100%;
    height: auto;
}

/* A label or a chosen value too long for its column ends in an ellipsis
   instead of wrapping: a wrapped value pushes the control's bottom border
   out of its row. */
#cloudwatch_filter_bar Label {
    width: 100%;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#cloudwatch_filter_bar SelectCurrent {
    padding: 0 1;
}

#cloudwatch_filter_bar SelectCurrent Static#label {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* An open list may be wider than its control, so a region or log group name
   reads on one line even when the filters are squeezed. */
#cloudwatch_filter_bar SelectOverlay {
    width: auto;
    min-width: 100%;
    max-width: 64;
}

#cloudwatch_filter_bar Button {
    width: 100%;
    min-width: 0;
    margin: 1 0 0 0;
}

CloudWatchBrowserScreen.-narrow #cloudwatch_filter_bar {
    grid-size: 4 2;
    grid-columns: 6fr 8fr 9 9;
}

CloudWatchBrowserScreen.-narrow #cw_filter_time_range,
CloudWatchBrowserScreen.-narrow #cw_filter_pattern {
    column-span: 2;
}

/* With several AWS accounts the account picker leads the filters in a
   column of its own (the grid gets the -with-account class). Narrow, the
   filter pattern widens so the second row stays full. */
#cloudwatch_filter_bar.-with-account {
    grid-size: 7 1;
    grid-columns: 18 3fr 3fr 22 2fr 10 10;
}

CloudWatchBrowserScreen.-narrow #cloudwatch_filter_bar.-with-account {
    grid-size: 5 2;
    grid-columns: 16 6fr 8fr 9 9;
}

CloudWatchBrowserScreen.-narrow #cloudwatch_filter_bar.-with-account #cw_filter_pattern {
    column-span: 3;
}

#cw_filter_account > Select {
    width: 100%;
}

#cloudwatch_main_content {
    height: 1fr;
    margin: 0 1;
}

#cloudwatch_events_table {
    width: 1fr;
    height: 100%;
    border: round $primary;
    margin: 0 1 0 0;
}

/* Wide enough for a full IPv4 address, a count and the WAF action, with
   the table's border and scrollbar. */
#cloudwatch_ips_panel {
    width: 41;
    height: 100%;
    border: round $accent;
    padding: 0 1;
    background: $boost;
}

#cw_top_ips_header {
    height: 1;
    width: 100%;
    align: center middle;
}

#cw_top_ips_label {
    width: 1fr;
    text-align: center;
    color: $accent;
}

#cw_btn_ip_filter {
    width: auto;
    min-width: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    padding: 0 1;
    margin: 0;
    height: 1;
}

#cloudwatch_ips_table {
    height: 1fr;
    border: round $primary;
}

#cloudwatch_pager {
    height: auto;
    align: center middle;
    padding: 0 1;
    margin: 0 1;
}

#cloudwatch_pager Button {
    margin: 0 1;
}

#cw_page_info {
    content-align: center middle;
    width: 1fr;
    text-align: center;
}

#cloudwatch_ips_panel Button {
    width: 100%;
    margin-top: 1;
}

#cloudwatch_detail {
    height: auto;
    max-height: 25%;
    padding: 1;
    margin: 0 1 1 1;
    background: $panel;
    border: round $accent;
    overflow-y: auto;
}

/* A short terminal: single-row buttons and no padding around the event
   detail, so the tables keep most of the height. */
CloudWatchBrowserScreen.-short #cloudwatch_pager Button,
CloudWatchBrowserScreen.-short #cloudwatch_ips_panel Button {
    height: 1;
    border: none;
    margin: 0;
}

CloudWatchBrowserScreen.-short #cloudwatch_pager Button {
    min-width: 10;
}

CloudWatchBrowserScreen.-short #cloudwatch_detail {
    padding: 0 1;
    margin: 0 1;
}
