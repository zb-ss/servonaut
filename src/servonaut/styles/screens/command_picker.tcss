/* Saved and recent commands share a bounded native search/list reader. */
CommandPickerModal #picker_container {
    height: 26;
}

CommandPickerModal #picker_hint,
CommandPickerModal #picker_selection_hint {
    height: auto;
    color: $text-muted;
}

CommandPickerModal #picker_body {
    height: 1fr;
    min-height: 5;
}

CommandPickerModal #picker_search {
    width: 100%;
    margin: 0;
}

CommandPickerModal #picker_list {
    height: 1fr;
    min-height: 1;
    margin: 0;
    background: transparent;
    border: round $border-blurred;
}

CommandPickerModal #picker_list:focus {
    border: round $accent;
}

SaveCommandModal #save_name_label {
    height: auto;
    color: $text-muted;
}

SaveCommandModal #save_command_preview {
    height: auto;
    padding: 0 1;
    border-left: heavy $accent;
    background: $panel;
}
