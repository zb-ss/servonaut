/* Certificate operations stay scoped to an explicit team, server and recovery key. */
CaScreen #ca_content {
    padding: 0 2 1 2;
    background: $surface;
}

CaScreen #ca_overview {
    height: auto;
}

CaScreen #ca_workspace {
    height: 1fr;
    min-height: 26;
}

CaScreen #ca_setup {
    width: 36;
    height: 100%;
    margin: 0 1 0 0;
    background: $surface;
}

CaScreen #ca_report {
    height: 100%;
    padding: 0;
    border: none;
    margin: 0;
    background: $surface;
    overflow-y: auto;
}

CaScreen #ca_status_reader {
    height: 1fr;
    min-height: 7;
    padding: 0 1;
    border: round $border-blurred;
    background: transparent;
    scrollbar-gutter: stable;
}

CaScreen #ca_status_reader:focus-within {
    border: round $accent;
}

CaScreen #ca_status {
    height: auto;
    margin: 0;
}

CaScreen #ca_actions {
    height: auto;
    margin-top: 1;
}

CaScreen .credential_action_heading {
    height: auto;
    color: $text-muted;
    text-style: bold;
}

/* The action rows size to their buttons (ActionRow wraps them when they do
   not fit), so the buttons keep their natural width. */
CaScreen #ca_inspect_actions,
CaScreen #ca_server_actions {
    height: auto;
    margin-bottom: 1;
}

CaScreen.-content-narrow #ca_content {
    padding: 0 1;
}

CaScreen.-content-narrow #ca_workspace {
    height: auto;
    min-height: 0;
}

CaScreen.-content-narrow #ca_setup,
CaScreen.-content-narrow #ca_report {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

CaScreen.-content-narrow #ca_status_reader {
    height: 9;
}

/* Bitwarden's catalog, complete selected metadata and available tasks. */
BwVaultManagerScreen #bw_vault_mgr_container {
    padding: 0 2 1 2;
    background: $surface;
}

BwVaultManagerScreen #bw_vault_mgr_status {
    padding: 0 1;
    margin-bottom: 1;
}

BwVaultManagerScreen #bw_vault_mgr_workspace {
    height: 1fr;
    min-height: 22;
}

BwVaultManagerScreen #bw_vault_mgr_catalog {
    width: 1fr;
    height: 100%;
}

BwVaultManagerScreen #bw_vault_mgr_records {
    height: 1fr;
    min-height: 8;
    margin-bottom: 1;
}

BwVaultManagerScreen #bw_vault_mgr_records:focus-within,
BwVaultManagerScreen #bw_vault_mgr_detail:focus {
    border: round $accent;
}

BwVaultManagerScreen #bw_vault_mgr_table {
    min-height: 4;
}

BwVaultManagerScreen #bw_vault_mgr_detail {
    height: 8;
    min-height: 6;
    margin: 0;
    padding: 0 1;
    border: round $border-blurred;
    background: transparent;
}

BwVaultManagerScreen #bw_vault_mgr_actions {
    layout: vertical;
    width: 25;
    height: auto;
    margin: 0 0 0 1;
}

BwVaultManagerScreen .credential_task_group {
    height: auto;
    margin-bottom: 1;
}

BwVaultManagerScreen .credential_task_group ActionRow {
    height: auto;
}

BwVaultManagerScreen .credential_action_heading {
    height: auto;
    color: $text-muted;
    text-style: bold;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_container {
    padding: 0 1;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_workspace {
    layout: vertical;
    min-height: 20;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_catalog {
    width: 100%;
    height: 1fr;
    min-height: 12;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_detail {
    height: 5;
    min-height: 5;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_records {
    min-height: 6;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_table {
    min-height: 3;
}

BwVaultManagerScreen.-content-narrow #bw_vault_mgr_actions {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

BwVaultManagerScreen.-content-narrow .credential_task_group {
    width: 1fr;
    margin-right: 1;
}

/* Auto-bind keeps full host-key review adjacent to server matches when wide. */
VaultAutoBindScreen #auto_bind_scope {
    padding: 0 1;
    border: none;
    border-left: heavy $accent;
    background: $panel;
}

VaultAutoBindScreen #auto_bind_heading {
    height: auto;
}

VaultAutoBindScreen #auto_bind_title {
    width: 1fr;
    height: auto;
    content-align-vertical: middle;
}

VaultAutoBindScreen #auto_bind_vault_select {
    width: 2fr;
    max-width: 80;
}

VaultAutoBindScreen #auto_bind_workspace {
    height: 1fr;
    min-height: 12;
    margin-bottom: 1;
}

VaultAutoBindScreen #auto_bind_records {
    width: 3fr;
    height: 100%;
    margin: 0 1 0 0;
}

VaultAutoBindScreen #auto_bind_review {
    width: 2fr;
    /* Keep the full SHA256 line and trust caption readable in split view. */
    min-width: 58;
    height: 100%;
    background: transparent;
}

VaultAutoBindScreen #auto_bind_detail_scroll {
    height: 1fr;
    max-height: initial;
}

VaultAutoBindScreen #auto_bind_records:focus-within,
VaultAutoBindScreen #auto_bind_review:focus-within {
    border: round $accent;
}

VaultAutoBindScreen #auto_bind_trust {
    margin: 1 1 0 1;
    width: 1fr;
    text-wrap: wrap;
    text-overflow: fold;
}

VaultAutoBindScreen #auto_bind_actions {
    layout: horizontal;
    height: auto;
}

VaultAutoBindScreen #auto_bind_binding_actions,
VaultAutoBindScreen #auto_bind_selection_actions {
    height: auto;
    width: 1fr;
}

VaultAutoBindScreen #auto_bind_binding_actions {
    margin-right: 1;
}

VaultAutoBindScreen .credential_action_heading {
    height: auto;
    color: $text-muted;
    text-style: bold;
}

VaultAutoBindScreen .credential_binding_buttons,
VaultAutoBindScreen .credential_selection_buttons {
    height: auto;
}

VaultAutoBindScreen.-content-narrow #auto_bind_heading {
    layout: vertical;
}

VaultAutoBindScreen.-content-narrow #auto_bind_title,
VaultAutoBindScreen.-content-narrow #auto_bind_vault_select {
    width: 100%;
}

VaultAutoBindScreen.-content-narrow #auto_bind_workspace {
    layout: vertical;
    min-height: 12;
}

VaultAutoBindScreen.-content-narrow #auto_bind_records {
    width: 100%;
    height: 1fr;
    margin: 0 0 1 0;
}

VaultAutoBindScreen.-content-narrow #auto_bind_review {
    width: 100%;
    min-width: 0;
    height: auto;
}

VaultAutoBindScreen.-content-narrow #auto_bind_detail_scroll {
    height: auto;
    max-height: 6;
}

VaultAutoBindScreen.-content-narrow #auto_bind_actions {
    layout: vertical;
}

VaultAutoBindScreen.-content-narrow #auto_bind_binding_actions {
    margin: 0 0 1 0;
}

VaultAutoBindScreen.-short #auto_bind_workspace {
    margin-bottom: 0;
}

VaultAutoBindScreen.-short #auto_bind_detail_scroll {
    height: auto;
    max-height: 2;
}

VaultAutoBindScreen.-short #auto_bind_binding_actions {
    margin-bottom: 0;
}
