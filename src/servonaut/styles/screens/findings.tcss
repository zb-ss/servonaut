
/* ===================================================================
   Findings screens — proactive-monitoring inbox + finding detail.
   Compact triage controls and bounded evidence readers.
   =================================================================== */

#findings_container {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
}

#findings_heading {
    height: auto;
    border-bottom: solid $border-blurred;
    margin-bottom: 1;
}

#findings_subtitle {
    height: auto;
    text-align: left;
    margin-bottom: 1;
    color: $text-muted;
}

#findings_status_pill {
    width: auto;
    max-width: 70%;
    height: auto;
    text-align: right;
}

#findings_filter_line {
    text-align: left;
    padding: 0 1;
    height: auto;
    color: $text-muted;
    background: $panel;
}

#findings_progress {
    text-align: left;
    height: auto;
    margin-bottom: 1;
}

#findings_state_body {
    height: 1fr;
    min-height: 6;
    padding: 0 1;
}

#findings_table_card {
    width: 1fr;
    height: 100%;
    min-height: 6;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: transparent;
    padding: 0;
}

#findings_table_card:focus-within {
    border: round $accent;
}

#findings_table {
    height: 1fr;
}

#findings_actions {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.findings_card {
    border: round $border-blurred;
    background: transparent;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
    width: 1fr;
}

#finding_detail_context {
    height: auto;
    padding: 0 1;
    border-left: heavy $accent;
    background: $panel;
    margin-bottom: 1;
}

.findings_card_primary {
    border: round $accent;
}

.findings_card_warning {
    border: round $warning;
}

.findings_card_title {
    color: $text-accent;
    text-style: bold;
    padding: 0 0 1 0;
    /* auto, not 1: Textual heights include padding, so height 1 with a
       line of bottom padding leaves zero lines for the title text. */
    height: auto;
}

.findings_card_body {
    color: $text;
    height: auto;
}

.findings_card_note {
    color: $text-muted;
    padding: 1 0 0 0;
    height: auto;
}

.findings_kv_grid {
    height: auto;
}

.findings_kv_row {
    height: auto;
    layout: horizontal;
}

.findings_kv_label {
    width: 14;
    height: 1;
    color: $text-muted;
}

.findings_kv_value {
    width: 1fr;
    height: auto;
    color: $text;
}

.findings_actions_list {
    height: auto;
    padding: 0;
}

.findings_action_row {
    height: 1;
    layout: horizontal;
    padding: 0;
}

.findings_action_key {
    width: 6;
    height: 1;
    color: $text-accent;
    text-style: bold;
}

.findings_action_label {
    width: 1fr;
    height: 1;
    color: $text;
}

/* ---- Finding detail screen ---- */

#finding_detail_container {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
}

#finding_detail_title {
    height: auto;
    text-align: left;
    color: $text-accent;
}

#finding_detail_pill {
    text-align: left;
    height: auto;
}

#finding_detail_body {
    width: 1fr;
    height: 100%;
    min-height: 6;
    padding: 0 1;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: transparent;
}

#finding_detail_body:focus-within {
    border: round $accent;
    border-title-color: $text-accent;
}

#finding_detail_actions {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.finding_evidence_line {
    height: auto;
}

.finding_remediation_label {
    height: auto;
    padding: 1 0 0 0;
}

.finding_remediation_desc {
    height: auto;
    color: $text;
}

.finding_remediation_action {
    height: auto;
    color: $text-muted;
}

.finding_remediation_manual {
    height: auto;
    color: $text-muted;
}

/* ---- Remediation run buttons ---- */

.finding_remediation_run {
    margin: 0 0 0 2;
}

/* Keep validation visible above the application's default Static text role. */
DangerousToolConfirmModal #dangerous_confirm_error {
    color: $error;
}

FindingsScreen.-content-narrow #findings_heading {
    layout: vertical;
}

FindingsScreen.-content-narrow #findings_status_pill {
    width: 100%;
    max-width: 100%;
    text-align: left;
}

/* Child margins preserve card spacing in native descendant scrolling. */
FindingDetailScreen #finding_detail_body > .findings_card {
    padding: 0;
}

FindingDetailScreen #finding_detail_body > .findings_card > .findings_card_title {
    margin: 1 2 0 2;
}

FindingDetailScreen #finding_detail_body > .findings_card > .findings_card_body {
    margin: 0 2 1 2;
}

/* The actions sit above the reading surface and keep their natural width. */
#findings_triage_workspace {
    layout: vertical;
    height: 1fr;
    min-height: 14;
}

#finding_detail_workspace {
    layout: vertical;
    height: 1fr;
    min-height: 14;
}

#findings_table_card,
#finding_detail_body {
    width: 100%;
    height: 1fr;
}

FindingDetailScreen #finding_detail_body > .findings_card {
    background: $panel;
}
