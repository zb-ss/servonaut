/* ===================================================================
   INSTANCE LIST SCREEN
   =================================================================== */



#search_input {
    width: 1fr;
    margin: 0;
}

InstanceTable {
    height: 1fr;
    margin: 0 1;
    border: round $panel-lighten-2;
    background: transparent;
    /* One cell, muted: a solid bar under the rows reads as a second table. */
    scrollbar-size: 1 1;
    scrollbar-color: $border-blurred;
}

StatusBar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 2;
}

/* What the providers are doing while the list loads: a block of lines on the
   first run, one line on a refresh. Hidden until there is something to say. */
#fleet_load_status {
    display: none;
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $text;
}

/* Quick filters: state chips, then provider chips. */
#fleet_filters {
    width: 100%;
    height: auto;
}

#fleet_state_chips,
#fleet_provider_chips {
    width: auto;
    height: 1;
}

.fleet-chip-divider {
    width: 1;
    margin: 0 1 0 0;
    color: $border-blurred;
}

InstanceListScreen.-narrow #fleet_filters,
InstanceListScreen.-content-narrow #fleet_filters,
InstanceListScreen.-chat-open #fleet_filters {
    layout: vertical;
}

InstanceListScreen.-narrow .fleet-chip-divider,
InstanceListScreen.-content-narrow .fleet-chip-divider,
InstanceListScreen.-chat-open .fleet-chip-divider {
    display: none;
}

/* A chip is a pill: a faint panel fill says "click me" while it stays one row. */
.fleet-chip {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $text;
}

.fleet-chip:hover {
    background: $panel-lighten-2;
    color: $text-accent;
}

.fleet-chip:focus {
    background: $panel-lighten-2;
    text-style: bold underline;
}

.fleet-chip.--chosen {
    background: $accent;
    color: $background;
    text-style: bold;
}

/* Terminal-colour themes: fills are not reliable there, so a chosen chip is
   drawn reversed and an unchosen one underlined. */
.fleet-chip:ansi {
    background: $background;
    text-style: underline;
}

.fleet-chip.--chosen:ansi {
    background: $background;
    color: $text;
    text-style: bold reverse;
}

/* These out-rank the plain :focus rule above, so focus needs its own cue
   here: the same bold underline the sidebar gives a focused active entry. */
.fleet-chip:ansi:focus {
    text-style: bold underline;
}

.fleet-chip.--chosen:ansi:focus {
    text-style: bold underline reverse;
}

#fleet_summary_row {
    width: 100%;
    height: 1;
}

#fleet_summary {
    width: 1fr;
    color: $text-muted;
    /* One row at any width: a long summary is cut, not wrapped. */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#fleet_updated {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

#keyword_matches_label {
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#memory_discover_banner {
    /* One row at any width: the hint is cut with an ellipsis rather than
       wrapped, so the fleet table keeps its rows on short terminals. */
    height: 1;
    padding: 0 1;
    margin: 0 1;
    background: $boost;
    border-left: thick $accent;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#keyword_matches_container {
    height: auto;
    max-height: 30%;
    border: round $primary;
    margin: 0 1;
    background: transparent;
}

