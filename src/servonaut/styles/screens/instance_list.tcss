/* ===================================================================
   INSTANCE LIST SCREEN
   =================================================================== */



#search_input {
    width: 1fr;
    margin: 1 0;
}

InstanceTable {
    height: 1fr;
    margin: 0 1;
    border: round $panel-lighten-2;
    background: transparent;
    /* One cell, muted: a solid bar under the rows reads as a second table. */
    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-color: $border-blurred;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $accent;
}

StatusBar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 2;
}

ProgressIndicator {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $warning;
    display: none;
}

ProgressIndicator.--visible {
    display: block;
}

#keyword_matches_label {
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#memory_discover_banner {
    /* One row at any width: the hint is cut with an ellipsis rather than
       wrapped, so the fleet table keeps its rows on short terminals. */
    height: 1;
    padding: 0 1;
    margin: 0 1;
    background: $boost;
    border-left: thick $accent;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#keyword_matches_container {
    height: auto;
    max-height: 30%;
    border: round $primary;
    margin: 0 1;
    background: transparent;
}

