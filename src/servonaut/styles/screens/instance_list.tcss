/* ===================================================================
   INSTANCE LIST SCREEN
   =================================================================== */



#search_input {
    width: 1fr;
    margin: 1 0;
}

InstanceTable {
    height: 1fr;
    margin: 0 1;
    border: round $primary;
}

StatusBar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 2;
}

ProgressIndicator {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $warning;
    display: none;
}

ProgressIndicator.--visible {
    display: block;
}

#keyword_matches_label {
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#memory_discover_banner {
    height: auto;
    padding: 1 2;
    margin: 0 1 1 1;
    background: $boost;
    border: round $accent;
    color: $text;
}

/* Fleet Memory screen — match Memory Sync visual language: centred
   accent title + muted subtitle, rounded $primary card around the
   table, consistent button spacing. The container itself overrides
   memory_screen.tcss so this screen reads as a top-level fleet view
   rather than a per-instance variant. */
FleetMemoryScreen #memory-container {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

FleetMemoryScreen #memory-title {
    text-align: center;
    color: $accent;
    text-style: bold;
    margin-bottom: 0;
    height: auto;
}

FleetMemoryScreen #memory-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
    height: auto;
}

#fleet-memory-help {
    height: auto;
    padding: 0 1 1 1;
    color: $text-muted;
}

#fleet-memory-status {
    height: 1;
    padding: 0 1;
}

#fleet-memory-progress {
    height: 1;
    padding: 0 1;
    color: $accent;
}

#fleet-auto-scan-status {
    height: 1;
    padding: 0 1;
}

/* Rounded card framing the DataTable so the table reads as an inset
   surface (matches .msync_card on Memory Sync, the IP Ban content
   panels, etc.). DataTable inside takes 1fr to fill the card. */
#fleet-memory-table-card {
    height: 1fr;
    margin: 0 1;
    border: round $primary;
    background: $surface;
    padding: 0;
}

#fleet-memory-table {
    height: 1fr;
    margin: 0;
    background: $surface;
}

FleetMemoryScreen #memory-actions {
    height: auto;
    padding: 1 1 0 1;
    align: left middle;
}

FleetMemoryScreen #memory-actions Button {
    margin-right: 1;
    min-width: 14;
}

#keyword_matches_container {
    height: auto;
    max-height: 30%;
    border: round $primary;
    margin: 0 1;
    background: $boost;
}

