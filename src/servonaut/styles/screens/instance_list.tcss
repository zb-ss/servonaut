/* ===================================================================
   INSTANCE LIST SCREEN
   =================================================================== */



/* The label above the search box needs a spare row: tall terminals only. */
#fleet_search_label {
    display: none;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

InstanceListScreen.-tall #fleet_search_label {
    display: block;
}

#search_input {
    width: 1fr;
    margin: 0;
}

InstanceTable {
    height: 1fr;
    margin: 0 1;
    border: round $panel-lighten-2;
    background: transparent;
    /* One cell, muted: a solid bar under the rows reads as a second table. */
    scrollbar-size: 1 1;
    scrollbar-color: $border-blurred;
}

StatusBar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 2;
}

/* What the providers are doing while the list loads: a block of lines on the
   first run, one line on a refresh. Hidden until there is something to say. */
#fleet_load_status {
    display: none;
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $text;
}

/* Quick filters: state chips, then provider chips. */
#fleet_filters {
    width: 100%;
    height: auto;
}

#fleet_state_chips,
#fleet_provider_chips {
    width: auto;
    height: 1;
}

.fleet-chip-divider {
    width: 1;
    margin: 0 1 0 0;
    color: $border-blurred;
}

InstanceListScreen.-narrow #fleet_filters,
InstanceListScreen.-content-narrow #fleet_filters,
InstanceListScreen.-chat-open #fleet_filters {
    layout: vertical;
}

InstanceListScreen.-narrow .fleet-chip-divider,
InstanceListScreen.-content-narrow .fleet-chip-divider,
InstanceListScreen.-chat-open .fleet-chip-divider {
    display: none;
}

/* A chip is one row by default: a faint panel fill says "click me" while it
   costs no height. Roomy terminals draw outlined pills instead (below). */
.fleet-chip {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $text;
}

.fleet-chip:hover {
    border: none;
    background: $panel-lighten-2;
    color: $text-accent;
}

.fleet-chip:focus {
    border: none;
    background: $panel-lighten-2;
    text-style: bold underline;
}

.fleet-chip.--chosen {
    border: none;
    background: $accent;
    color: $background;
    text-style: bold;
}

/* Roomy terminals (wide, tall, nothing beside the table): outlined pills. The
   chosen one has an accent outline and accent text, the others a dim outline. */
InstanceListScreen.-roomy #fleet_state_chips,
InstanceListScreen.-roomy #fleet_provider_chips {
    height: 3;
}

InstanceListScreen.-roomy .fleet-chip {
    height: 3;
    padding: 0;
    border: round $border-blurred;
    background: transparent;
    color: $text;
}

InstanceListScreen.-roomy .fleet-chip:hover,
InstanceListScreen.-roomy .fleet-chip:focus {
    border: round $accent;
    background: transparent;
    color: $text-accent;
}

InstanceListScreen.-roomy .fleet-chip.--chosen {
    border: round $accent;
    background: transparent;
    color: $text-accent;
    text-style: bold;
}

/* Terminal-colour themes: fills are not reliable there, so a chosen chip is
   drawn reversed and an unchosen one underlined. */
.fleet-chip:ansi {
    background: $background;
    text-style: underline;
}

.fleet-chip.--chosen:ansi {
    background: $background;
    color: $text;
    text-style: bold reverse;
}

/* These out-rank the plain :focus rule above, so focus needs its own cue
   here: the same bold underline the sidebar gives a focused active entry. */
.fleet-chip:ansi:focus {
    text-style: bold underline;
}

.fleet-chip.--chosen:ansi:focus {
    text-style: bold underline reverse;
}

/* In a pill the outline carries the state, so the ansi cues are lighter. */
InstanceListScreen.-roomy .fleet-chip:ansi {
    text-style: none;
}

InstanceListScreen.-roomy .fleet-chip.--chosen:ansi {
    text-style: bold;
}

InstanceListScreen.-roomy .fleet-chip:ansi:focus {
    text-style: bold underline;
}

/* Freshness and Refresh sit at the right of the chip row. */
#fleet_fresh {
    width: 1fr;
    min-width: 12;
    height: 1;
    align-horizontal: right;
}

InstanceListScreen.-roomy #fleet_fresh {
    height: 3;
    align-vertical: middle;
}

InstanceListScreen.-narrow #fleet_fresh,
InstanceListScreen.-content-narrow #fleet_fresh,
InstanceListScreen.-chat-open #fleet_fresh {
    width: 100%;
    height: 1;
}

#fleet_updated {
    width: 1fr;
    padding: 0;
    color: $text-muted;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* One row under the table at any width: a long summary is cut, not wrapped. */
#fleet_summary {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#keyword_matches_label {
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#memory_discover_banner {
    /* One row at any width: the hint is cut with an ellipsis rather than
       wrapped, so the fleet table keeps its rows on short terminals. */
    height: 1;
    padding: 0 1;
    margin: 0 1;
    background: $boost;
    border-left: thick $accent;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#keyword_matches_container {
    height: auto;
    max-height: 30%;
    border: round $primary;
    margin: 0 1;
    background: transparent;
}

