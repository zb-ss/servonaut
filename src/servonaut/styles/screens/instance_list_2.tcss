


#instance_list_container {
    width: 1fr;
    height: 100%;
    /* One column at each side, not two: the fleet table needs the width. */
    padding: 1 1;
    background: $surface;
}

#instance_list_container InstanceTable {
    height: 1fr;
    margin-top: 1;
}

#instance_detail {
    height: 3;
    min-height: 3;
    background: $panel;
    border: none;
    color: $text;
    margin-top: 1;
}

