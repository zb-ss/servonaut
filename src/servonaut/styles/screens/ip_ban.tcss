/* ===================================================================
   IP BAN SCREEN
   =================================================================== */

#ip_ban_container {
    width: 1fr;
    height: 100%;
    padding: 1;
}

#ip_ban_title {
    text-align: center;
    color: $accent;
}

#ip_ban_subtitle {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

/* Shown only while no ban configuration exists. */
#ip_ban_empty_hint {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: round $warning;
    color: $text;
}

.field_label {
    margin: 0 0 0 0;
    color: $text-muted;
}

#ip_ban_top_row {
    height: auto;
    max-height: 5;
    margin: 0 0 1 0;
}

#ip_ban_config_col {
    width: 1fr;
    margin-right: 1;
}

#ip_ban_input_col {
    width: 1fr;
    margin-left: 1;
}

#ban_config_selector {
    width: 100%;
    height: auto;
}

/* Keep the prompt or the chosen configuration on one line. Wrapped, it
   makes the select taller than its row, which cuts off the bottom border. */
#ban_config_selector SelectCurrent #label {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#ip_input {
    width: 100%;
}

#ip_ban_actions {
    height: auto;
    margin: 0 0 1 0;
}

#ip_ban_actions Button {
    margin: 0 1 0 0;
}

#ip_ban_main_content {
    height: 1fr;
}

#ip_ban_table_col {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

#ip_ban_audit_col {
    width: 1fr;
    height: 100%;
    margin-left: 1;
}

#banned_table {
    height: 1fr;
    max-height: 20;
    border: round $primary;
}

#audit_log {
    height: 1fr;
    max-height: 20;
    padding: 1;
    background: $panel;
    border: round $primary;
    overflow-y: auto;
}

