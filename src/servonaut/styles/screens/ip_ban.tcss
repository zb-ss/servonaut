/* ===================================================================
   IP BAN SCREEN
   =================================================================== */

#ip_ban_container {
    width: 1fr;
    height: 100%;
    padding: 1 2 0 2;
    background: $surface;
}

#ip_ban_title {
    height: auto;
    text-align: left;
    color: $text;
    text-style: bold;
}

#ip_ban_subtitle {
    height: auto;
    text-align: left;
    margin-bottom: 1;
    color: $text-muted;
}

/* Shown only while no ban configuration exists. */
#ip_ban_empty_hint {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: round $warning;
    color: $text;
}

.field_label {
    margin: 0 0 0 0;
    color: $text-muted;
}

#ip_ban_top_row {
    height: auto;
    margin: 0 0 1 0;
}

#ip_ban_config_col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

#ip_ban_input_col {
    width: 1fr;
    height: auto;
    margin-left: 1;
}

#ban_config_selector {
    width: 100%;
    height: auto;
}

/* Keep the prompt or the chosen configuration on one line. Wrapped, it
   makes the select taller than its row, which cuts off the bottom border. */
#ban_config_selector SelectCurrent #label {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#ip_input {
    width: 100%;
}

#ip_ban_actions {
    height: auto;
    margin: 1 0 0 0;
}

#ip_ban_main_content {
    height: 1fr;
}

#ip_ban_table_col {
    width: 1fr;
    height: 100%;
    margin-right: 1;
    padding: 0 1;
    border: round $primary;
    background: transparent;
}

#ip_ban_audit_col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    border: round $primary;
    background: transparent;
}

#banned_table {
    height: 1fr;
    border: none;
}

#audit_log {
    height: 1fr;
    padding: 0;
    background: $surface;
    border: none;
    overflow-y: auto;
}


/* Leave a heading plus a readable table/audit viewport when setup copy wraps. */
IPBanScreen #ip_ban_main_content {
    min-height: 12;
}

IPBanScreen #ip_ban_container {
    overflow-y: hidden;
}

IPBanScreen #ip_ban_workflow {
    height: 1fr;
    padding: 0;
}

IPBanScreen #ip_ban_target {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    border: round $primary;
    background: transparent;
}

IPBanScreen .ip-ban-section-title {
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

IPBanScreen .field_label,
IPBanScreen .ip-ban-help {
    height: auto;
    color: $text-muted;
}

IPBanScreen #ip_ban_scope_hint {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

IPBanScreen.-content-narrow #ip_ban_container {
    padding: 0 1;
}

IPBanScreen.-content-narrow #ip_ban_top_row {
    layout: vertical;
    height: auto;
}

IPBanScreen.-content-narrow #ip_ban_config_col,
IPBanScreen.-content-narrow #ip_ban_input_col {
    width: 100%;
    height: auto;
    margin: 0;
}

IPBanScreen.-content-narrow #ip_ban_main_content {
    layout: vertical;
    height: 26;
}

IPBanScreen.-content-narrow #ip_ban_table_col,
IPBanScreen.-content-narrow #ip_ban_audit_col {
    width: 100%;
    height: 12;
    margin: 0 0 1 0;
}

/* Put the access change beside its live address inventory. */
IPBanScreen #ip_ban_container { padding: 0 2 1 2; background: transparent; }
IPBanScreen #ip_ban_subtitle { margin: 0 0 1 0; }
IPBanScreen #ip_ban_main_content {
    height: auto;
    min-height: 0;
    margin-bottom: 1;
}
IPBanScreen #ip_ban_target {
    width: 2fr;
    max-width: 42;
    height: auto;
    padding: 0 1;
    margin: 0 1 0 0;
    border: round $border-blurred;
    background: transparent;
}
IPBanScreen #ip_ban_top_row { layout: vertical; height: auto; margin: 0; }
IPBanScreen #ip_ban_config_col,
IPBanScreen #ip_ban_input_col { width: 100%; height: auto; margin: 0 0 1 0; }
IPBanScreen #ban_config_selector,
IPBanScreen #ip_input { margin: 0; }
IPBanScreen #ip_ban_scope_hint { height: auto; margin: 0 0 1 0; }
IPBanScreen #ip_ban_table_col {
    width: 3fr;
    height: auto;
    margin: 0;
    padding: 0 1;
    border: round $primary;
}
IPBanScreen #banned_table {
    height: 12;
    min-height: 6;
    border: none;
    background: $surface;
}
IPBanScreen #ip_ban_selection_actions { width: 100%; height: auto; margin: 1 0 0 0; }
IPBanScreen #ip_ban_use_selected,
IPBanScreen #ip_ban_copy_selected {
    min-width: 0;
}
IPBanScreen #ip_ban_audit_col {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: round $border-blurred;
}
IPBanScreen #audit_log { height: 6; min-height: 4; }
IPBanScreen #ip_ban_actions {
    dock: bottom;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0 1;
    border-top: solid $border-blurred;
    background: $surface;
}
IPBanScreen.-content-narrow #ip_ban_container { padding: 0 1 1 1; }
IPBanScreen.-content-narrow #ip_ban_main_content { layout: vertical; height: auto; min-height: 0; }
IPBanScreen.-content-narrow #ip_ban_target,
IPBanScreen.-content-narrow #ip_ban_table_col,
IPBanScreen.-content-narrow #ip_ban_audit_col {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

/* Header-only tables can use the existing floor in a narrow workflow. */
IPBanScreen.-content-narrow #banned_table {
    height: auto;
    max-height: 12;
}
