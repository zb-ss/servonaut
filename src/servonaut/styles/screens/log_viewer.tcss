/* ===================================================================
   LOG VIEWER SCREEN
   =================================================================== */

#log_viewer_container {
    width: 1fr;
    height: 100%;
}

#log_header {
    dock: top;
    padding: 1 2;
    background: $primary;
    color: $text;
    text-style: bold;
}

#log_output {
    height: 1fr;
    background: $panel;
    padding: 1;
    margin: 0 1;
    border: round $primary;
}

#log_hints {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $boost;
    color: $text-muted;
}

