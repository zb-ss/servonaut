/* Account status is the masthead; each authentication state owns one workspace. */
LoginScreen #login_container {
    width: 1fr;
    height: 100%;
    align: center top;
    padding: 1 2;
    background: $surface;
    overflow-x: hidden;
    overflow-y: auto;
}

LoginScreen #login_box {
    width: 100%;
    max-width: 112;
    height: auto;
    padding: 0 0 1 0;
}

LoginScreen #account_heading {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

LoginScreen #login_title {
    width: 1fr;
    height: auto;
    color: $text;
    text-style: bold;
}

LoginScreen #account_state_summary {
    width: 1fr;
    height: auto;
    padding-left: 1;
    border-left: thick $accent;
    color: $text;
}

LoginScreen #account_overview {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

LoginScreen .auth_state_container {
    width: 100%;
    height: auto;
}

LoginScreen #logged_out_container,
LoginScreen #logged_in_container {
    layout: horizontal;
}

LoginScreen .account_panel {
    width: 1fr;
    height: auto;
    padding: 1;
    margin: 0 1 1 0;
    background: transparent;
}

LoginScreen #browser_sign_in_panel,
LoginScreen #account_info_header {
    border: round $border-blurred;
    background: transparent;
}

LoginScreen .account_section_heading {
    margin-bottom: 1;
    height: auto;
    color: $text;
}

LoginScreen #login_description,
LoginScreen #browser_sign_in_hint,
LoginScreen #account_info,
LoginScreen #plan_info,
LoginScreen #entitlements_info {
    height: auto;
    margin-bottom: 1;
}

LoginScreen #plan_info {
    padding-top: 1;
    border-top: solid $border-blurred;
}

LoginScreen .login_notice {
    height: auto;
    border: round $border-blurred;
    background: transparent;
    padding: 1;
    margin-bottom: 1;
}

LoginScreen #device_flow_container {
    border: round $border-blurred;
    background: transparent;
    padding: 1;
    margin-bottom: 1;
}

LoginScreen #device_flow_steps {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

LoginScreen #device_credentials,
LoginScreen #device_progress {
    width: 1fr;
    height: auto;
}

LoginScreen #device_progress {
    padding: 0 1;
    margin-left: 1;
    border-left: solid $border-blurred;
}

LoginScreen #device_code_info,
LoginScreen #device_url,
LoginScreen #device_code,
LoginScreen #device_status,
LoginScreen #device_flow_hint,
LoginScreen #account_authorization_busy {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

LoginScreen #device_flow_hint {
    color: $text-muted;
}

LoginScreen #device_code {
    padding: 1;
    color: $text;
    background: $boost;
    text-style: bold;
}

LoginScreen #account_authorization_busy {
    color: $text-accent;
}

LoginScreen #login_actions {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 2fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    width: 100%;
    height: auto;
    padding-top: 1;
    border-top: solid $border-blurred;
}

LoginScreen #login_actions Button,
LoginScreen #btn_login,
LoginScreen #btn_cancel_login {
    width: 100%;
    min-width: 0;
    height: 3;
    margin: 0;
}

LoginScreen #btn_login {
    margin-top: 1;
}

LoginScreen #btn_cancel_login {
    width: 20;
    max-width: 100%;
}

LoginScreen.-content-narrow #login_container {
    padding: 1;
}

LoginScreen.-content-narrow #account_heading,
LoginScreen.-content-narrow #logged_out_container,
LoginScreen.-content-narrow #logged_in_container,
LoginScreen.-content-narrow #device_flow_steps,
LoginScreen.-content-narrow #login_actions {
    layout: vertical;
}

LoginScreen.-content-narrow #login_title,
LoginScreen.-content-narrow #account_state_summary,
LoginScreen.-content-narrow .account_panel,
LoginScreen.-content-narrow #device_credentials,
LoginScreen.-content-narrow #device_progress {
    width: 100%;
    margin-right: 0;
}

LoginScreen.-content-narrow #login_title {
    margin-bottom: 1;
}

LoginScreen.-content-narrow #device_progress {
    border-left: none;
    border-top: solid $border-blurred;
    padding: 1 0 0 0;
    margin-left: 0;
}

LoginScreen.-content-narrow #login_actions Button {
    margin-bottom: 1;
}
