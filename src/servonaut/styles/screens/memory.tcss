/* ===================================================================
   Memory Subsystem — cloud sync, drift, settings, export, share,
   upsell modals, passphrase enrol.
   =================================================================== */

/* Which teams the server is shared with takes the accent, as a status line. */
MemoryScreen #memory-share-state {
    color: $text-accent;
}

/* Full memory views keep records and decisions close to their context. */
MemoryDriftScreen .memory-secondary-heading,
MemoryExportScreen .memory-secondary-heading,
ShareInstanceScreen .memory-secondary-heading {
    width: 1fr;
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
}

MemoryDriftScreen #drift-context,
MemoryExportScreen #export-context,
ShareInstanceScreen #share-context {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

/* Drift: compact review controls above the change ledger. */
MemoryDriftScreen #drift-container {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

MemoryDriftScreen #drift-filter-label {
    height: auto;
    margin: 0;
}

MemoryDriftScreen #drift-records {
    height: 1fr;
    min-height: 10;
    border: round $panel;
    background: transparent;
}

MemoryDriftScreen #drift-table {
    height: 1fr;
    background: $surface;
}

MemoryDriftScreen #drift-tools {
    height: auto;
    margin-bottom: 1;
}

MemoryDriftScreen #drift-actions {
    width: 100%;
    height: auto;
}

MemoryDriftScreen #drift-empty-state {
    height: auto;
    padding: 1;
    color: $text-muted;
}

/* Export: a bounded form beside its verification document. */
MemoryExportScreen #export-scroll {
    width: 1fr;
    height: 1fr;
}

MemoryExportScreen #export-container {
    padding: 0 1;
    width: 1fr;
    height: auto;
}

MemoryExportScreen #export-description {
    height: auto;
    max-width: 96;
    margin: 0;
}

MemoryExportScreen #export-workspace {
    height: auto;
    min-height: 16;
}

MemoryExportScreen #export-range-panel,
MemoryExportScreen #export-result-panel {
    height: auto;
    min-height: 16;
    border: round $panel;
    background: transparent;
}

MemoryExportScreen #export-range-panel {
    width: 2fr;
    margin-right: 1;
}

MemoryExportScreen #export-result-panel {
    width: 3fr;
}

MemoryExportScreen #export-date-fields {
    layout: vertical;
    height: auto;
    padding: 1 1 0 1;
}

MemoryExportScreen .export-field-row {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

MemoryExportScreen #export-status {
    height: auto;
    min-height: 3;
    padding: 1 1;
}

MemoryExportScreen #export-btn-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 2fr 1fr;
    grid-gutter: 0 1;
    /* Auto-row measurement must retain space for native borders and line padding during reflow. */
    min-width: 16;
    height: auto;
    padding: 0 1;
}

MemoryExportScreen #export-btn-row Button {
    width: 1fr;
    height: auto;
    min-height: 3;
    min-width: 0;
    margin: 0;
    padding: 0;
}

MemoryExportScreen.-content-narrow #export-workspace {
    layout: vertical;
}

MemoryExportScreen.-content-narrow #export-range-panel,
MemoryExportScreen.-content-narrow #export-result-panel {
    width: 100%;
    margin-right: 0;
}

MemoryExportScreen.-content-narrow #export-range-panel {
    margin-bottom: 1;
}

MemoryExportScreen.-content-narrow #export-result-panel {
    min-height: 8;
}

/* Sharing: the editable records scroll; the explicit decision stays visible. */
ShareInstanceScreen #share_outer {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

ShareInstanceScreen #share-container {
    width: 1fr;
    height: 1fr;
}

/* No room kept while empty: at 100x30 every row counts. */
ShareInstanceScreen #share-status {
    height: auto;
}

ShareInstanceScreen #share-form-scroll {
    height: 1fr;
    min-height: 6;
    overflow-y: auto;
}

ShareInstanceScreen #share-access-fields {
    height: auto;
}

ShareInstanceScreen #share-access-panel,
ShareInstanceScreen #share-modules-panel {
    height: auto;
    margin-bottom: 1;
    border: round $panel;
    background: transparent;
}

ShareInstanceScreen #share-access-panel {
    width: 2fr;
    margin-right: 1;
}

ShareInstanceScreen #share-modules-panel {
    width: 3fr;
}

ShareInstanceScreen .share-field-row {
    height: auto;
    margin: 0 1 1 1;
}

ShareInstanceScreen #share-readers,
ShareInstanceScreen #share-existing-text {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

ShareInstanceScreen #share-modules-list {
    height: 12;
    margin: 0 1 1 1;
}

ShareInstanceScreen #share-existing {
    display: none;
    height: auto;
    margin-bottom: 1;
    border: round $panel;
    background: transparent;
}

ShareInstanceScreen #share-existing.-shown {
    display: block;
}

ShareInstanceScreen #share-existing-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
    padding: 0 1;
}

ShareInstanceScreen #share-existing-row Button,
ShareInstanceScreen #share-btn-row Button {
    width: 1fr;
    height: auto;
    min-height: 3;
    min-width: 0;
    margin: 0;
    padding: 0;
}

ShareInstanceScreen #share-btn-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
    margin-top: 1;
}

ShareInstanceScreen.-content-narrow #share-access-fields {
    layout: vertical;
}

ShareInstanceScreen.-content-narrow #share-access-panel,
ShareInstanceScreen.-content-narrow #share-modules-panel {
    width: 100%;
    margin-right: 0;
}

ShareInstanceScreen.-content-narrow #share-existing-row {
    grid-size: 1;
    grid-columns: 1fr;
}

/* --- Upsell modal --- */
#upsell-container {
    width: 64;
    height: auto;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}

#upsell-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

#upsell-body {
    margin-bottom: 1;
}

#upsell-btn-row {
    height: auto;
    align: right middle;
    margin-top: 1;
}

#upsell-btn-close {
    margin-right: 1;
}

/* --- Beta waitlist modal --- */
#waitlist-container {
    width: 60;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#waitlist-title {
    text-style: bold;
    margin-bottom: 1;
}

#waitlist-body {
    margin-bottom: 1;
}

#waitlist-btn-row {
    height: auto;
    align: center middle;
    margin-top: 1;
}

/* --- Backend maintenance modal --- */
#maintenance-container {
    width: 60;
    height: auto;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

#maintenance-title {
    text-style: bold;
    color: $error;
    margin-bottom: 1;
}

#maintenance-body {
    margin-bottom: 1;
}

#maintenance-btn-row {
    height: auto;
    align: center middle;
    margin-top: 1;
}

/* --- Passphrase enrol modal --- */
/* On shorter terminals the shared dialog chrome tightens; this dialog also
   gives up the spacing between its stacked sections so they stay in view. */
PassphraseEnrolModal.-dialog-minimal #enrol-blurb,
PassphraseEnrolModal.-dialog-tight #enrol-blurb,
PassphraseEnrolModal.-dialog-minimal #enrol-rules,
PassphraseEnrolModal.-dialog-tight #enrol-rules,
PassphraseEnrolModal.-dialog-minimal #enrol-pass1_field,
PassphraseEnrolModal.-dialog-tight #enrol-pass1_field {
    margin-bottom: 0;
}

#enrol-title {
    text-style: bold;
}

#enrol-blurb {
    margin-bottom: 1;
    color: auto 100%;
}

PassphraseEnrolModal:ansi #enrol-blurb,
PassphraseEnrolModal:ansi #enrol-mismatch {
    color: $foreground;
}

#enrol-rules {
    margin-bottom: 1;
    height: auto;
}

#enrol-strength {
    height: auto;
}

#enrol-mismatch {
    color: $text-error;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#enrol-mismatch.ready {
    color: $text-success;
}

#enrol-pass1_field,
#enrol-pass2_field {
    margin: 0;
}

#enrol-pass1_field {
    margin-bottom: 1;
}

#enrol-btn-row {
    height: auto;
    align: right middle;
}

#enrol-btn-cancel {
    margin-right: 1;
}

/* --- Drift diff modal --- */
#drift-diff-container {
    width: 90%;
    height: 80%;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#drift-diff-title {
    text-style: bold;
    margin-bottom: 1;
}

#drift-diff-body {
    height: 1fr;
    overflow: auto;
    border: round $panel;
    padding: 0 1;
}

#drift-diff-close-row {
    height: auto;
    align: right middle;
    margin-top: 1;
}



/* Memory Sync: a device ledger with separate key and sync controls. */
MemorySyncSetupScreen #msync_container {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

MemorySyncSetupScreen #msync_context {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

MemorySyncSetupScreen #msync_heading_row {
    height: auto;
}

MemorySyncSetupScreen #msync_title,
MemorySyncSetupScreen #msync_subtitle,
MemorySyncSetupScreen #msync_status {
    height: auto;
    margin: 0;
    text-align: left;
}

MemorySyncSetupScreen #msync_title {
    width: 1fr;
    color: $text;
    text-style: bold;
}

MemorySyncSetupScreen #msync_subtitle {
    color: $text-muted;
    max-width: 96;
}

MemorySyncSetupScreen #msync_status {
    width: auto;
    max-width: 50%;
    min-height: 1;
    text-align: right;
}

MemorySyncSetupScreen #msync_body {
    height: 1fr;
    min-height: 6;
}

MemorySyncSetupScreen .msync_card_stack {
    layout: horizontal;
    height: auto;
    width: 1fr;
}

MemorySyncSetupScreen .msync_card {
    border: round $panel;
    background: transparent;
    padding: 0 1;
    margin: 0 0 1 0;
    height: auto;
    width: 100%;
}

MemorySyncSetupScreen .msync_card_stack > .msync_card {
    width: 2fr;
}

MemorySyncSetupScreen .msync_card_stack > .msync_card:first-child {
    width: 3fr;
    margin-right: 1;
}

MemorySyncSetupScreen .msync_card_title {
    height: auto;
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

MemorySyncSetupScreen .msync_card_body {
    padding: 0 0 1 0;
    color: $text;
    height: auto;
}

MemorySyncSetupScreen .msync_card_warning {
    color: $text-warning;
}

MemorySyncSetupScreen .msync_card_actions {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    height: auto;
    align: left middle;
    padding: 0;
}

MemorySyncSetupScreen .msync_card_actions Button {
    width: 1fr;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 0;
    min-width: 0;
}

MemorySyncSetupScreen .msync_benefits {
    height: auto;
    padding: 0 0 1 0;
}

MemorySyncSetupScreen .msync_benefit_row {
    height: auto;
    color: $text;
}

MemorySyncSetupScreen .msync_kv_grid {
    height: auto;
}

MemorySyncSetupScreen .msync_kv_row {
    height: auto;
    layout: horizontal;
    padding: 0 1;
    margin-bottom: 1;
    background: $boost;
}

MemorySyncSetupScreen .msync_kv_label {
    width: 18;
    height: auto;
    color: $text-muted;
}

MemorySyncSetupScreen .msync_kv_value {
    width: 1fr;
    height: auto;
    color: $text;
}

MemorySyncSetupScreen .msync_configured_actions {
    layout: vertical;
}

MemorySyncSetupScreen.-content-narrow .msync_card_stack {
    layout: vertical;
}

MemorySyncSetupScreen.-content-narrow .msync_card_stack > .msync_card,
MemorySyncSetupScreen.-content-narrow .msync_card {
    width: 100%;
    margin-right: 0;
}

MemorySyncSetupScreen.-content-narrow .msync_card_actions {
    layout: vertical;
}

/* The "Probe server now" call to action. A Container's default height is
   1fr, which is zero on a page taller than the screen (the notes and
   findings panels make it so), and the button would be clipped away. */
MemoryScreen #memory-empty-state {
    height: auto;
    margin-bottom: 1;
}

/* Notes and agent findings: authored text, below the module actions */
#memory-authored {
    height: auto;
    margin-bottom: 1;
}

.memory-section-heading {
    height: auto;
    margin-top: 1;
}

#memory-notes {
    height: auto;
    padding: 0 1;
    border-left: thick $primary;
}

#memory-findings-notice {
    height: auto;
    color: $text-muted;
}

#memory-findings-table {
    height: auto;
    max-height: 12;
}

#memory-findings-empty {
    height: auto;
    color: $text-muted;
}

/* One finding in full (MemoryFindingScreen) */
#memory-finding-container {
    width: 1fr;
    padding: 1 1 0 1;
}

#memory-finding-server {
    height: auto;
    margin-bottom: 1;
}

#memory-finding-notice {
    height: auto;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
    border-left: thick $warning;
}

#memory-finding-scroll {
    height: 1fr;
    border: round $primary;
    background: transparent;
    padding: 0 1;
}

#memory-finding-title,
#memory-finding-meta,
#memory-finding-body,
#memory-finding-chain {
    height: auto;
    margin-bottom: 1;
}

#memory-finding-actions {
    height: auto;
    align: right middle;
    padding: 1 0;
}

/* Fleet Memory: one action row above the records; an empty fleet shows a card. */
FleetMemoryScreen #memory-actions {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
}

FleetMemoryScreen #fleet-memory-empty {
    width: 64;
    max-width: 90%;
    height: auto;
    margin: 0;
    padding: 0 2;
    border: round $border-blurred;
    background: transparent;
}

FleetMemoryScreen #fleet-memory-table-card {
    align: center middle;
}

FleetMemoryScreen #fleet-memory-banner {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: round $border-blurred;
    background: transparent;
}

FleetMemoryScreen #fleet-banner-text {
    width: 1fr;
    height: auto;
    color: $text-muted;
}

FleetMemoryScreen #fleet-empty-title {
    height: auto;
    margin-bottom: 1;
    color: $text-accent;
    text-style: bold;
}

FleetMemoryScreen #fleet-empty-text {
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}
