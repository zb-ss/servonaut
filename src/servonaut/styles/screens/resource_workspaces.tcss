/* Resource-specific panels keep their native tables and inline forms. */
OVHDNSScreen #dns_container,
OVHFirewallScreen #firewall_container,
OVHIPManagementScreen #ip_mgmt_container,
OVHSnapshotsScreen #snapshots_container,
OVHStorageScreen #storage_container,
OVHBillingScreen #billing_container,
ObjectStorageScreen #s3_container {
    padding: 1 2 2 2;
}

OVHDNSScreen #dns_title,
OVHFirewallScreen #firewall_title,
OVHIPManagementScreen #ip_mgmt_title,
OVHSnapshotsScreen #snapshots_title,
OVHStorageScreen #storage_title,
OVHBillingScreen #billing_title,
ObjectStorageScreen #s3_title {
    height: auto;
    text-align: left;
    text-style: bold;
    color: $text-accent;
    padding: 0;
    margin: 0;
}

.resource-workspace-content .resource-context {
    height: auto;
    color: $text-muted;
    margin: 0 0 1 0;
}

.resource-workspace-content AccountPicker {
    height: auto;
    margin: 1 0;
}

.resource-workspace-content .resource-panel {
    height: auto;
    width: 1fr;
    padding: 0 1;
    margin: 0 0 1 0;
    border: round $primary-background;
    background: transparent;
}

.resource-workspace-content .resource-section-title,
.resource-workspace-content .section_header {
    height: auto;
    color: $text-accent;
    text-style: bold;
    border: none;
    padding: 0;
    margin: 0 0 1 0;
}

OVHDNSScreen #selected_zone,
OVHFirewallScreen #firewall_status,
OVHSnapshotsScreen #backup_status,
OVHBillingScreen #current_usage,
OVHBillingScreen #spend_history {
    height: auto;
    margin: 0 0 1 0;
}

OVHSnapshotsScreen #backup_section_title {
    height: auto;
    color: $text-accent;
    margin-bottom: 1;
}

OVHDNSScreen #dns_container DataTable,
OVHFirewallScreen #firewall_container DataTable,
OVHIPManagementScreen #ip_mgmt_container DataTable,
OVHSnapshotsScreen #snapshots_table,
OVHStorageScreen #storage_container DataTable,
OVHBillingScreen #billing_container DataTable,
ObjectStorageScreen #s3_table {
    height: auto;
    min-height: 4;
    max-height: 12;
    margin: 0 0 1 0;
    border: none;
}

OVHDNSScreen #dns_container #domains_table,
OVHDNSScreen #dns_container #rdns_table,
OVHBillingScreen #billing_container #services_table {
    max-height: 8;
}

ObjectStorageScreen #s3_table,
OVHIPManagementScreen #ip_mgmt_container #ip_table {
    max-height: 18;
}

OVHBillingScreen #billing_container #invoices_table {
    max-height: 12;
}

ObjectStorageScreen #s3_breadcrumb {
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
    color: $text-accent;
}

ObjectStorageScreen #s3_status {
    height: auto;
    padding: 0;
    margin: 0;
}

/* Keep all actions in their original traversal order, but make browsing,
   transfers and selected-resource operations distinct within one toolbar. */
OVHStorageScreen .resource-workspace-content #storage_actions,
ObjectStorageScreen .resource-workspace-content #s3_actions {
    layout: vertical;
    height: auto;
    padding: 0;
    margin: 0;
    align: left top;
}

ObjectStorageScreen .resource-workspace-content #s3_actions {
    padding: 0 1;
    border: round $primary-background;
    background: transparent;
    margin-bottom: 1;
}

.resource-workspace-content .resource-action-group {
    height: auto;
    align: left top;
}

.resource-workspace-content .resource-action-label {
    width: 10;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

.resource-workspace-content .resource-action-buttons {
    width: 1fr;
    height: auto;
    align: left top;
}

OVHStorageScreen .resource-workspace-content #storage_actions Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin: 0 1 0 0;
}

OVHStorageScreen.-content-narrow .resource-action-buttons,
ObjectStorageScreen.-content-narrow .resource-action-buttons {
    layout: grid;
    grid-size: 3;
    grid-rows: 3;
    grid-gutter: 0 1;
}

OVHStorageScreen.-content-narrow .resource-action-buttons {
    grid-size: 2;
}

OVHStorageScreen.-content-narrow .resource-workspace-content #storage_actions Button {
    width: 1fr;
    margin: 0;
}

OVHDNSScreen #dns_actions,
OVHDNSScreen #rdns_actions,
OVHFirewallScreen #firewall_actions,
OVHIPManagementScreen #ip_actions,
OVHSnapshotsScreen #snapshots_actions {
    layout: grid;
    height: auto;
    grid-size: 3;
    grid-rows: 3;
    grid-gutter: 0 1;
    padding: 0;
    margin: 0;
}

OVHSnapshotsScreen #snapshots_actions {
    grid-size: 4;
}

OVHFirewallScreen.-content-narrow #firewall_actions,
OVHIPManagementScreen.-content-narrow #ip_actions,
OVHSnapshotsScreen.-content-narrow #snapshots_actions {
    grid-size: 2;
}

OVHDNSScreen #dns_actions Button,
OVHDNSScreen #rdns_actions Button,
OVHFirewallScreen #firewall_actions Button,
OVHIPManagementScreen #ip_actions Button,
OVHSnapshotsScreen #snapshots_actions Button {
    width: 1fr;
    min-width: 0;
    padding: 0 1;
    margin: 0;
}

ObjectStorageScreen.-content-narrow .resource-action-buttons,
OVHDNSScreen #dns_actions,
OVHDNSScreen.-content-narrow #dns_actions,
OVHSnapshotsScreen #snapshots_actions,
OVHSnapshotsScreen.-content-narrow #snapshots_actions {
    grid-rows: auto;
}

OVHDNSScreen #dns_actions Button,
OVHSnapshotsScreen #snapshots_actions Button {
    height: auto;
    min-height: 3;
}

/* Show/hide remains owned by the original form handlers. */
OVHDNSScreen #record_form,
OVHDNSScreen #rdns_form,
OVHStorageScreen #create_vol_form,
OVHStorageScreen #attach_vol_form,
OVHStorageScreen #snapshot_form,
ObjectStorageScreen #s3_new_bucket_form,
ObjectStorageScreen #s3_upload_form,
ObjectStorageScreen #s3_download_form,
ObjectStorageScreen #s3_copy_form,
ObjectStorageScreen #s3_move_form,
ObjectStorageScreen #s3_url_display {
    height: auto;
    padding: 0 1;
    margin: 1 0;
    border: round $primary-background;
    background: transparent;
}

.resource-workspace-content .add_row {
    height: auto;
    margin: 0;
}

OVHIPManagementScreen #rdns_btn_row {
    height: auto;
}

.resource-workspace-content .add_row Button {
    min-width: 0;
    width: auto;
    padding: 0 1;
    margin: 0 1 0 0;
}

.resource-workspace-content .resource-billing-summary {
    height: auto;
    align: left top;
}

.resource-workspace-content .resource-billing-summary .resource-panel {
    margin-right: 1;
}

OVHBillingScreen.-content-narrow .resource-billing-summary {
    layout: vertical;
}

OVHBillingScreen.-content-narrow .resource-billing-summary .resource-panel {
    margin-right: 0;
}

.resource-workspace-content .resource-back-actions {
    height: auto;
    margin-bottom: 1;
}

OVHBillingScreen #invoice_pagination {
    height: auto;
    margin: 0;
}

OVHBillingScreen #invoice_pagination Button {
    min-width: 0;
    width: auto;
    margin: 0 1 0 0;
}

/* Storage inventory and operations share a workspace, with account context
   above them and inline forms beside the resource they act on. */
.provider-aux-workspace .provider-aux-heading-row {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    align: left top;
}

.provider-aux-workspace .provider-aux-heading {
    width: 1fr;
    height: auto;
}

.provider-aux-workspace .provider-aux-heading .resource-context {
    margin: 0;
}

.provider-aux-workspace .provider-aux-heading-row AccountPicker {
    width: 26;
    height: auto;
    margin: 0 0 0 1;
}

.provider-aux-workspace .provider-aux-body {
    width: 1fr;
    height: auto;
    align: left top;
}

.provider-aux-workspace .provider-aux-inventory {
    width: 1fr;
    height: auto;
    border: round $border-blurred;
    background: transparent;
}

ObjectStorageScreen .provider-aux-inventory #s3_table,
OVHStorageScreen .provider-aux-inventory #volumes_table {
    height: auto;
    min-height: 6;
    max-height: 22;
}

ObjectStorageScreen .provider-aux-inventory #s3_status {
    margin-bottom: 1;
    color: $text-muted;
}

.provider-aux-workspace .provider-aux-operations {
    width: 44;
    height: auto;
    margin-left: 1;
    padding: 0 1;
    border: round $border-blurred;
    background: transparent;
}

.provider-aux-workspace .provider-aux-section-heading {
    height: auto;
    color: $text-accent;
    text-style: bold;
}

.provider-aux-workspace .provider-aux-selection {
    height: auto;
    margin-bottom: 1;
    color: $text;
}

ObjectStorageScreen .provider-aux-workspace #s3_actions,
OVHStorageScreen .provider-aux-workspace #storage_actions {
    height: auto;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

.provider-aux-workspace .resource-action-group {
    layout: vertical;
    height: auto;
    margin-bottom: 1;
}

.provider-aux-workspace .resource-action-label {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    content-align: left top;
}

ObjectStorageScreen .provider-aux-workspace .resource-action-buttons,
OVHStorageScreen .provider-aux-workspace .resource-action-buttons {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    width: 1fr;
    height: auto;
}

/* Native auto-row measurement needs borders, line padding and a text cell. */
ObjectStorageScreen .provider-aux-workspace .resource-action-buttons {
    min-width: 11;
}

OVHStorageScreen .provider-aux-workspace #storage_actions Button {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 0;
}

.provider-aux-workspace .add_row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
}

.provider-aux-workspace .add_row Button {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 0;
}

/* A domain navigator and its zone editor form one task. Reverse DNS remains
   a separate account inventory with its own selection and actions. */
OVHDNSScreen .provider-dns-zones {
    width: 1fr;
    height: auto;
    align: left top;
}

OVHDNSScreen .provider-aux-workspace .provider-dns-domains {
    width: 28;
    height: auto;
    border: round $border-blurred;
}

OVHDNSScreen .provider-aux-workspace .provider-dns-records {
    width: 1fr;
    height: auto;
    margin-left: 1;
    border: round $border-blurred;
}

OVHDNSScreen .provider-aux-workspace .provider-dns-reverse {
    height: auto;
    margin-top: 1;
    border: round $border-blurred;
}

OVHDNSScreen #dns_container .provider-dns-domains #domains_table {
    min-height: 4;
    max-height: 10;
}

OVHDNSScreen #dns_container .provider-dns-records #records_table {
    min-height: 6;
    max-height: 12;
}

OVHDNSScreen #dns_container .provider-dns-reverse #rdns_table {
    min-height: 4;
    max-height: 8;
}

OVHDNSScreen .provider-aux-workspace #dns_actions,
OVHDNSScreen .provider-aux-workspace #rdns_actions {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
}

OVHDNSScreen .provider-aux-workspace #dns_actions Button,
OVHDNSScreen .provider-aux-workspace #rdns_actions Button {
    height: auto;
    min-height: 3;
    padding: 0;
}

ObjectStorageScreen.-content-narrow .provider-aux-heading-row,
OVHStorageScreen.-content-narrow .provider-aux-heading-row,
OVHDNSScreen.-content-narrow .provider-aux-heading-row,
ObjectStorageScreen.-content-narrow .provider-aux-body,
OVHStorageScreen.-content-narrow .provider-aux-body,
OVHDNSScreen.-content-narrow .provider-dns-zones {
    layout: vertical;
}

ObjectStorageScreen.-content-narrow .provider-aux-heading-row AccountPicker,
OVHStorageScreen.-content-narrow .provider-aux-heading-row AccountPicker,
OVHDNSScreen.-content-narrow .provider-aux-heading-row AccountPicker {
    width: 1fr;
    margin: 1 0 0 0;
}

ObjectStorageScreen.-content-narrow .provider-aux-operations,
OVHStorageScreen.-content-narrow .provider-aux-operations {
    width: 1fr;
    margin: 0;
}

/* Keep the complete object toolbar within a short scrolling viewport. */
ObjectStorageScreen.-content-narrow .provider-aux-workspace .resource-action-group {
    layout: horizontal;
    margin-bottom: 0;
}

ObjectStorageScreen.-content-narrow .provider-aux-workspace .resource-action-label {
    width: 10;
    margin-bottom: 0;
}

OVHDNSScreen.-content-narrow .provider-dns-domains,
OVHDNSScreen.-content-narrow .provider-dns-records {
    width: 1fr;
    margin-left: 0;
}

OVHDNSScreen.-content-narrow #dns_container .provider-dns-domains #domains_table {
    max-height: 6;
}
