
/* ===================================================================
   Secrets management screen — status/control hub.
   Visual language mirrors Memory Sync: rounded $primary borders for
   context cards, rounded $accent borders for the primary CTA card,
   $surface backgrounds.
   =================================================================== */

#secrets_container {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#secrets_title {
    text-align: center;
    color: $accent;
}

#secrets_subtitle {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

#secrets_status_pill {
    text-align: center;
    margin-bottom: 1;
    height: 1;
}

#secrets_body {
    height: 1fr;
    padding: 0 1;
}

.secrets_card {
    border: round $primary;
    background: $surface;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
    width: 1fr;
}

.secrets_card_primary {
    border: round $accent;
}

.secrets_card_warning {
    border: round $warning;
}

.secrets_card_title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
    height: 1;
}

.secrets_card_body {
    padding: 0 0 0 0;
    color: $text;
    height: auto;
}

.secrets_card_note {
    color: $text-muted;
    padding: 1 0 0 0;
    height: auto;
}

.secrets_kv_grid {
    height: auto;
    padding: 0 0 0 0;
}

.secrets_kv_row {
    height: 1;
    layout: horizontal;
}

.secrets_kv_label {
    width: 22;
    height: 1;
    color: $text-muted;
}

.secrets_kv_value {
    width: 1fr;
    height: 1;
    color: $text;
}

.secrets_actions {
    height: auto;
    padding: 0;
}

.secrets_action_row {
    height: 1;
    layout: horizontal;
    padding: 0;
}

.secrets_action_key {
    width: 6;
    height: 1;
    color: $accent;
    text-style: bold;
}

.secrets_action_label {
    width: 1fr;
    height: 1;
    color: $text;
}

/* ---- Secrets list sub-screen ---- */

#secrets_list_container {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#secrets_list_title {
    text-align: center;
    color: $accent;
}

#secrets_list_subtitle {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

#secrets_list_summary {
    text-align: center;
    margin-bottom: 1;
    height: 1;
}

#secrets_list_body {
    height: 1fr;
    padding: 0 1;
}

.secrets_list_card {
    border: round $primary;
    background: $surface;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
    width: 1fr;
}

.secrets_list_name {
    height: 1;
    color: $text;
    padding: 0 0 0 1;
}

/* ─── ssh verify modal ─── */

ConfirmSshVerifyModal {
    align: center middle;
}

#ssh_verify_modal_container {
    width: 72;
    height: 11;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#ssh_verify_modal_title {
    text-style: bold;
    margin-bottom: 1;
}

#ssh_verify_modal_body {
    height: 5;
}

.ssh_verify_actions_row {
    height: auto;
    align: right middle;
    margin-top: 1;
}

.ssh_verify_actions_row Button {
    margin-left: 1;
    min-width: 12;
}

/* ---- Clear-cache confirmation modal ---- */

#confirm_clear_container {
    width: 60%;
    max-width: 70;
    height: auto;
    background: $surface;
    border: round $warning;
    padding: 1 2;
}

#confirm_clear_text {
    padding: 0 0 1 0;
    height: auto;
}

#confirm_clear_buttons {
    layout: horizontal;
    height: auto;
    align: right middle;
}

#confirm_clear_buttons Button {
    margin-left: 1;
    min-width: 12;
}

/* ─── bw ssh vault settings ─── */
#bw_ssh_vault_form {
    height: auto;
    padding: 1;
    margin: 1 0 0 0;
    border: round $accent;
    background: $boost;
}

#bw_ssh_vault_form Input {
    margin: 0 0 1 0;
}

/* ─── ssh ref editor ─── */
SshRefEditorModal {
    align: center middle;
}

#ssh_ref_editor_container {
    width: 70;
    height: 19;
    padding: 1;
    border: round $accent;
    background: $surface;
}

#ssh_ref_editor_container Label {
    margin: 0 0 1 0;
}

#ssh_ref_editor_container Input {
    margin: 0 0 1 0;
}

.ssh_ref_actions_row {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

.ssh_ref_actions_row Button {
    margin: 0 1 0 1;
}

.ssh_ref_pick_row {
    height: 3;
    align: left middle;
    margin: 0 0 1 0;
}

/* ---- Bitwarden SSH vault: unlock + item picker modals ---- */
#bw_unlock_container {
    width: 64;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#bw_unlock_title {
    margin: 0 0 1 0;
}

#bw_unlock_body {
    height: auto;
}

.bw_unlock_actions {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

#bw_picker_container {
    width: 90;
    height: 30;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#bw_picker_title {
    margin: 0 0 1 0;
}

#bw_picker_body {
    height: 1fr;
}

#bw_picker_table {
    height: 1fr;
    margin: 1 0;
}

.bw_picker_actions {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}
