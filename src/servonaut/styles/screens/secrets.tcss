
/* ===================================================================
   Secrets management screen — status/control hub.
   Visual language mirrors Memory Sync: rounded $primary borders for
   context cards, rounded $accent borders for the primary CTA card,
   $surface backgrounds.
   =================================================================== */

#secrets_container {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#secrets_status_pill {
    text-align: center;
    margin-bottom: 1;
    height: 1;
}

#secrets_body {
    height: 1fr;
    padding: 0 1;
}

.secrets_card {
    border: round $primary;
    background: transparent;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
    width: 1fr;
}

.secrets_card_primary {
    border: round $accent;
}

.secrets_card_warning {
    border: round $warning;
}

.secrets_card_title {
    color: $accent;
    text-style: bold;
    padding: 0 0 1 0;
    height: 1;
}

.secrets_card_body {
    padding: 0 0 0 0;
    color: $text;
    height: auto;
}

.secrets_card_note {
    color: $text-muted;
    padding: 1 0 0 0;
    height: auto;
}

.secrets_kv_grid {
    height: auto;
    padding: 0 0 0 0;
}

.secrets_kv_row {
    height: 1;
    layout: horizontal;
}

.secrets_kv_label {
    width: 22;
    height: 1;
    color: $text-muted;
}

.secrets_kv_value {
    width: 1fr;
    height: 1;
    color: $text;
}

/* ---- Secrets list sub-screen ---- */

#secrets_list_container {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#secrets_list_title {
    text-align: center;
    color: $accent;
}

#secrets_list_subtitle {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

#secrets_list_summary {
    text-align: center;
    margin-bottom: 1;
    height: 1;
}

#secrets_list_body {
    height: 1fr;
    padding: 0 1;
}

.secrets_list_card {
    border: round $primary;
    background: transparent;
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
    width: 1fr;
}

.secrets_list_name {
    height: 1;
    color: $text;
    padding: 0 0 0 1;
}

/* Full-screen secret stores separate context, native records and controls. */
SecretsScreen #secrets_container,
SecretsListScreen #secrets_list_container,
SecretsSetupScreen #secrets_setup_container,
BwVaultManagerScreen #bw_vault_mgr_container {
    padding: 1 2 0 2;
    overflow-y: auto;
}

SecretsScreen .secrets_overview,
SecretsListScreen .secrets_list_heading,
SecretsSetupScreen .secrets_setup_heading,
BwVaultManagerScreen .bw_vault_mgr_overview {
    height: auto;
    margin-bottom: 1;
}

SecretsScreen #secrets_body {
    min-height: 6;
    padding: 0;
}

SecretsScreen .secrets_card {
    border: round $border-blurred;
    padding: 1;
}

SecretsScreen .secrets_card_primary {
    border: round $primary;
}

SecretsScreen .secrets_card_warning {
    border: round $warning;
}

SecretsScreen .secrets_card_title {
    height: auto;
    min-height: 1;
    color: $text;
    padding: 0;
    margin-bottom: 1;
}

SecretsScreen .secrets_kv_row,
SecretsScreen .secrets_kv_value {
    height: auto;
    min-height: 1;
}

SecretsListScreen #secrets_list_records,
BwVaultManagerScreen #bw_vault_mgr_records {
    height: 1fr;
    min-height: 10;
    border: round $border-blurred;
    background: transparent;
    padding: 0 1;
}

.secrets_section_title {
    height: auto;
    min-height: 1;
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

SecretsListScreen #secrets_list_filter {
    margin: 0 0 1 0;
}

SecretsListScreen #secrets_list_summary {
    height: auto;
    text-align: left;
    color: $text-muted;
    margin: 0 0 1 0;
}

SecretsListScreen #secrets_list_body {
    min-height: 3;
    padding: 0;
}

SecretsListScreen .secrets_list_card {
    border: none;
    padding: 0;
    margin: 0;
}

SecretsListScreen .secrets_list_name {
    padding: 0 1;
}

SecretsSetupScreen #secrets_setup_body {
    min-height: 6;
    padding: 0;
}

SecretsSetupScreen #secrets_setup_workspace {
    height: auto;
}

SecretsSetupScreen #secrets_setup_readiness,
SecretsSetupScreen #secrets_setup_project {
    height: auto;
    width: 1fr;
    border: round $border-blurred;
    background: transparent;
    padding: 1;
}

SecretsSetupScreen #secrets_setup_readiness {
    margin-right: 1;
}

SecretsSetupScreen #setup_preflight {
    height: auto;
    margin: 0;
}

SecretsSetupScreen #token_env {
    margin: 0 0 1 0;
}

SecretsSetupScreen #project_list {
    height: 8;
    min-height: 4;
    margin: 0;
    border: none;
    background: $surface;
}

SecretsSetupScreen #setup_buttons {
    height: auto;
    margin: 1 0 0 0;
}

SecretsSetupScreen #setup_status,
BwVaultManagerScreen #bw_vault_mgr_status {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $text-muted;
}

BwVaultManagerScreen #bw_vault_mgr_table {
    height: 1fr;
    min-height: 6;
    max-height: 100%;
    border: none;
    margin: 0;
}

BwVaultManagerScreen #bw_vault_mgr_actions {
    height: auto;
    padding: 0;
    margin: 1 0 0 0;
}

SecretsScreen.-content-narrow #secrets_container,
SecretsListScreen.-content-narrow #secrets_list_container,
SecretsSetupScreen.-content-narrow #secrets_setup_container,
BwVaultManagerScreen.-content-narrow #bw_vault_mgr_container {
    padding: 0 1;
}

SecretsScreen.-content-narrow .secrets_kv_row {
    layout: vertical;
    margin-bottom: 1;
}

SecretsScreen.-content-narrow .secrets_kv_label {
    width: 100%;
}

SecretsSetupScreen.-content-narrow #secrets_setup_workspace {
    layout: vertical;
}

SecretsSetupScreen.-content-narrow #secrets_setup_readiness,
SecretsSetupScreen.-content-narrow #secrets_setup_project {
    width: 100%;
    margin: 0 0 1 0;
}

/* ─── ssh verify modal ─── */

ConfirmSshVerifyModal {
    align: center middle;
}

ConfirmSshVerifyModal Container#ssh_verify_modal_container {
    width: 72;
    /* auto: the body is 4-6 lines depending on the has_ref variant — fixed
       heights clipped the Cancel/Confirm row entirely. */
    height: auto;
    background: $surface;
    border: round $accent;
    padding: 1 2;
}

#ssh_verify_modal_title {
    text-style: bold;
    margin-bottom: 1;
}

#ssh_verify_modal_body {
    height: auto;
}

ConfirmSshVerifyModal Container#ssh_verify_modal_container > .ssh_verify_actions_row {
    height: auto;
    align: right middle;
    margin-top: 1;
}

ConfirmSshVerifyModal Container#ssh_verify_modal_container > .ssh_verify_actions_row Button {
    margin-left: 1;
    min-width: 12;
}

/* ─── bw ssh vault settings ─── */
#bw_ssh_vault_form {
    height: auto;
    padding: 1;
    margin: 1 0 0 0;
    border: round $accent;
    background: transparent;
}

#bw_ssh_vault_form Input {
    margin: 0 0 1 0;
}

/* ─── ssh ref editor ─── */
SshRefEditorModal {
    align: center middle;
}

SshRefEditorModal Container#ssh_ref_editor_container {
    width: 70;
    /* auto: the Advanced collapsible adds ~13 rows when expanded — a fixed
       height clips the revealed inputs, making the toggle look like a no-op. */
    height: auto;
    max-height: 90%;
    /* fallback for short terminals: scroll inside the modal rather than clip */
    overflow-y: auto;
    padding: 1;
    border: round $accent;
    background: $surface;
}

SshRefEditorModal Container#ssh_ref_editor_container #ssh_ref_fields {
    height: auto;
}

/* labels already separate the rows — the global 1-row input margin would
   push the action buttons past the max-height cap on 40-row terminals.
   Double-id selector: must out-rank the later "#ssh_ref_editor_container
   Input" rule in the cascade. */
#ssh_ref_editor_container #ssh_ref_advanced Input {
    margin: 0;
}

#ssh_ref_editor_container Label {
    margin: 0 0 1 0;
}

#ssh_ref_editor_container Input {
    margin: 0 0 1 0;
}

SshRefEditorModal Container#ssh_ref_editor_container .ssh_ref_actions_row {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

SshRefEditorModal Container#ssh_ref_editor_container .ssh_ref_actions_row Button {
    margin: 0 1 0 1;
}

.ssh_ref_pick_row {
    height: 3;
    align: left middle;
    margin: 0 0 1 0;
}

/* ---- Bitwarden SSH vault: unlock + item picker modals ---- */
BwItemPickerModal {
    align: center middle;
}

#bw_unlock_body {
    height: auto;
}

.bw_unlock_actions {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

BwItemPickerModal Container#bw_picker_container {
    width: 90;
    height: 30;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#bw_picker_title {
    margin: 0 0 1 0;
}

#bw_picker_body {
    height: 1fr;
}

#bw_picker_table {
    height: 1fr;
    margin: 1 0;
}

.bw_picker_actions {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

/* ---- Bitwarden SSH vault: key-import flow modals ---- */
BwDirPickerModal {
    align: center middle;
}

BwPassphraseModal {
    align: center middle;
}

BwKeyImportModal {
    align: center middle;
}

BwDirPickerModal Container#bw_dir_picker_container {
    width: 64;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#bw_dir_picker_title {
    margin: 0 0 1 0;
}

#bw_dir_picker_hint {
    margin: 0 0 1 0;
}

BwDirPickerModal Container#bw_dir_picker_container #bw_dir_tree {
    height: 12;
    margin: 0 0 1 0;
}

BwDirPickerModal Container#bw_dir_picker_container .bw_dir_actions {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

BwDirPickerModal Container#bw_dir_picker_container .bw_dir_actions Button {
    margin: 0 1;
}

/* Leave room for the password's native Show/Hide control. */
BwPassphraseModal #bw_passphrase_input {
    width: 1fr;
}

VaultRenameKeyModal #vault_rename_key_feedback {
    color: $text-warning;
}

BwKeyImportModal Container#bw_import_container {
    width: 90;
    height: 30;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#bw_import_title {
    margin: 0 0 1 0;
}

#bw_import_semantics {
    margin: 0 0 1 0;
    height: auto;
    color: $text-muted;
}

#bw_import_list {
    height: 1fr;
    margin: 0 0 1 0;
}

#bw_import_status {
    /* auto: status strings (import-blocked guidance, long filenames) wrap to
       a second line — a fixed height of 1 clips the actionable tail. */
    height: auto;
    min-height: 1;
}

BwKeyImportModal Container#bw_import_container .bw_import_actions {
    height: 3;
    align: center middle;
    margin: 1 0 0 0;
}

BwKeyImportModal Container#bw_import_container .bw_import_actions Button {
    margin: 0 1;
}

/* Secrets readiness and full action targets, scoped to the status hub. */
SecretsScreen #secrets_container { padding: 0 2 1 2; }
SecretsScreen .secrets_overview { height: auto; margin-bottom: 1; }
SecretsScreen #secrets_heading_row { height: auto; align: left top; }
SecretsScreen #secrets_status_pill {
    width: auto;
    max-width: 55%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
    text-align: right;
}
SecretsScreen #secrets_body { padding: 0; min-height: 6; }
SecretsScreen #secrets_body .secrets_card { padding: 1; }
SecretsScreen #secrets_body .secrets_card_title { height: auto; margin-bottom: 1; }
SecretsScreen #secrets_body .secrets_card_actions {
    border: none;
    background: transparent;
    padding: 0;
}
SecretsScreen #secrets_body .secrets_kv_row { height: auto; margin-bottom: 0; }
SecretsScreen #secrets_body .secrets_kv_label { width: 20; height: auto; }
SecretsScreen #secrets_body .secrets_kv_value { width: 1fr; height: auto; min-width: 0; }
SecretsScreen #secrets_body .secrets_actions {
    width: 100%;
    height: auto;
}
SecretsScreen #secrets_body .secrets_actions.-wrap {
    grid-gutter: 0 0;
}
SecretsScreen #secrets_body .secrets_action {
    min-width: 0;
}
SecretsScreen.-content-narrow #secrets_container { padding: 0 1 1 1; }
SecretsScreen.-content-narrow #secrets_heading_row { layout: vertical; }
SecretsScreen.-content-narrow #secrets_status_pill {
    width: 100%;
    max-width: 100%;
    margin-top: 1;
    text-align: left;
}

/* Setup keeps the verified-project controls above the footer. */
SecretsSetupScreen #secrets_setup_container {
    padding: 0 2 1 2;
    overflow-y: hidden;
}
SecretsSetupScreen .secrets_setup_heading { height: auto; margin-bottom: 1; }
SecretsSetupScreen #secrets_setup_title {
    height: auto;
    color: $text;
    text-style: bold;
    text-align: left;
}
SecretsSetupScreen #secrets_setup_subtitle {
    height: auto;
    color: $text-muted;
    margin: 1 0 0 0;
    text-align: left;
}
SecretsSetupScreen #secrets_setup_body { height: 1fr; min-height: 4; padding: 0; }
SecretsSetupScreen #secrets_setup_workspace { height: auto; }
SecretsSetupScreen #secrets_setup_readiness {
    width: 1fr;
    max-width: 42;
    height: auto;
    margin: 0 2 0 0;
}
SecretsSetupScreen #secrets_setup_project {
    width: 2fr;
    height: auto;
    border: round $primary;
}
SecretsSetupScreen #setup_preflight { height: auto; }
SecretsSetupScreen .setup_label { height: auto; margin-bottom: 1; color: $text; }
SecretsSetupScreen .secrets_setup_note {
    height: auto;
    margin: 0 0 1 0;
    color: $text-muted;
}
SecretsSetupScreen #project_list { height: 12; min-height: 6; }
SecretsSetupScreen #secrets_setup_actions {
    dock: bottom;
    height: auto;
    width: 100%;
    padding: 0 1;
    border-top: solid $border-blurred;
    background: $surface;
}
SecretsSetupScreen #secrets_setup_feedback {
    height: auto;
    min-height: 1;
    max-height: 5;
    padding: 0;
}
SecretsSetupScreen #secrets_setup_feedback #setup_status {
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
}
SecretsSetupScreen #secrets_setup_actions #setup_buttons {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    height: auto;
    margin: 0;
}
SecretsSetupScreen #secrets_setup_actions #setup_buttons Button {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 3;
    margin: 0;
    padding: 0 1;
}
SecretsSetupScreen.-content-narrow #secrets_setup_container { padding: 0 1 1 1; }
SecretsSetupScreen.-content-narrow #secrets_setup_workspace { layout: vertical; }
SecretsSetupScreen.-content-narrow #secrets_setup_readiness,
SecretsSetupScreen.-content-narrow #secrets_setup_project {
    width: 100%;
    max-width: 100%;
    margin: 0 0 1 0;
}

/* A stable filter and record viewport; names remain selectable Static text. */
SecretsListScreen #secrets_list_container { padding: 0 2 1 2; }
SecretsListScreen .secrets_list_heading { height: auto; margin-bottom: 1; }
SecretsListScreen #secrets_list_title {
    height: auto;
    color: $text;
    text-style: bold;
    text-align: left;
}
SecretsListScreen #secrets_list_subtitle {
    height: auto;
    margin: 1 0 0 0;
    color: $text-muted;
    text-align: left;
}
SecretsListScreen #secrets_list_records { height: 1fr; min-height: 16; padding: 0 1; }
SecretsListScreen #secrets_list_toolbar { height: auto; align: left middle; }
SecretsListScreen #secrets_list_toolbar .secrets_section_title {
    width: 1fr;
    height: 3;
    margin: 0;
    content-align: left middle;
}
SecretsListScreen #secrets_list_toolbar Button {
    width: auto;
    min-width: 10;
    height: 3;
    margin: 0 0 0 1;
}
SecretsListScreen .secrets_names_filter_label { height: auto; color: $text; }
SecretsListScreen #secrets_list_filter { margin: 0 0 1 0; }
SecretsListScreen #secrets_list_summary { height: auto; margin: 0 0 1 0; }
SecretsListScreen #secrets_list_body { height: 1fr; min-height: 3; padding: 0; }
SecretsListScreen .secrets_list_name { height: auto; min-height: 1; padding: 0 1; margin-bottom: 1; }
SecretsListScreen.-content-narrow #secrets_list_container { padding: 0 1 1 1; }
