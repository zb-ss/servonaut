/* ===================================================================
   SERVER ACTIONS SCREEN
   =================================================================== */

#sa-body {
    width: 1fr;
    height: 100%;
    background: $surface;
    layout: vertical;
}

/* One row of context: the shared screen header look, with no bar and no
   bottom border. */
#sa-context {
    width: 100%;
    height: auto;
    /* A very long name or account scrolls here instead of starving the cards. */
    max-height: 4;
    padding: 0 2;
    background: transparent;
}

ServerActionsScreen.-short #sa-context {
    padding: 0 1;
}

#server_context {
    height: auto;
}

/* Primary actions: one row, Back at the left and the rest at the right.
   The buttons themselves are ActionButton (components/action_button.tcss). */
#action_buttons {
    width: 100%;
    height: auto;
    layout: horizontal;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $border-blurred;
}

ServerActionsScreen.-short #action_buttons {
    padding: 0 1;
}

#action_buttons.-wrap {
    grid-size: 3;
}

#action_buttons.-wrap .sa-toolbar-spacer {
    display: none;
}

#action_buttons .sa-toolbar-spacer {
    width: 1fr;
    height: 1;
}

/* Main detail workspace (overview + inline tools) */
#sa-detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#sa-overview {
    height: 1fr;
    scrollbar-gutter: stable;
}

/* Two cards per row; the grid gives both cards the height of the taller one */
#sa-facts,
#sa-monitoring {
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-rows: auto;
    grid-gutter: 1 1;
}

#sa-detail .sa-section {
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    border: round $border-blurred;
    background: transparent;
}

/* Two cards per row, equal width; each card owns the actions that act on it */
#sa-facts .sa-section,
#sa-monitoring .sa-section {
    width: 100%;
    height: 100%;
    margin-bottom: 0;
}

#card_identity,
#card_network,
#card_live,
#card_memory {
    layout: vertical;
}

#server_identity,
#server_info,
#live_stats,
#memory_panel {
    width: 100%;
    height: auto;
}

.sa-card-actions {
    width: 100%;
    height: auto;
    padding: 0;
}

.sa-card-title {
    width: 100%;
    height: auto;
}

#sa-diagnostics .sa-card-actions,
#sa-provider .sa-card-actions {
    padding: 0;
}

/* Below about 96 content columns the cards stack (the class is set by the
   screen from the width the content really has; compact buttons are separate). */
ServerActionsScreen.-stack-cards #sa-facts,
ServerActionsScreen.-stack-cards #sa-monitoring {
    layout: vertical;
}

ServerActionsScreen.-stack-cards #sa-facts .sa-section,
ServerActionsScreen.-stack-cards #sa-monitoring .sa-section {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

ServerActionsScreen.-narrow .sa-card-actions,
ServerActionsScreen.-content-narrow .sa-card-actions {
    padding: 0;
}

/* Slow work indicator: pinned to bottom of detail pane */
#sa_busy {
    dock: bottom;
    padding: 0 2;
}

/* Inline read-only views (Browse / Logs):
   Collapse the action grid so the inline tree/log gets the full vertical viewport */
ServerActionsScreen.-inline-open #action_buttons {
    display: none;
}

#sa-detail.-inline-open #sa-overview {
    display: none;
}

#sa-inline {
    width: 100%;
    height: auto;
    display: none;
}

#sa-inline.visible {
    display: block;
    height: 1fr;
    min-height: 0;
    border: round $border-blurred;
    background: transparent;
}

#sa-inline .inline_title {
    padding: 0 1;
    background: $boost;
    color: $text;
    text-style: bold;
}

#sa-inline .inline_note {
    height: auto;
    padding: 0 1;
    border-top: round $surface-lighten-1;
}

#sa-inline RemoteTree,
#sa-inline RichLog {
    height: 1fr;
}

/* The note remains complete; its separator need not consume a tree row. */
ServerActionsScreen.-short #sa-inline .inline_note {
    border-top: none;
}

/* Short terminal adjustment */
ServerActionsScreen.-short #sa-detail {
    padding: 0 1;
}

ServerActionsScreen.-short #sa-detail .sa-section {
    padding: 0 1;
    margin-bottom: 0;
}

/* One row of compact buttons has to fit the narrowest content column */
ServerActionsScreen.-narrow #action_buttons,
ServerActionsScreen.-content-narrow #action_buttons {
    padding: 0;
}

/* Compact buttons draw no border but keep a one-cell line pad: shift the row so
   its first label starts flush with the card text above it */
ServerActionsScreen.-narrow .sa-card-actions,
ServerActionsScreen.-content-narrow .sa-card-actions {
    offset: -1 0;
}

ServerActionsScreen.-narrow .sa-card-actions ActionButton.-textual-compact,
ServerActionsScreen.-content-narrow .sa-card-actions ActionButton.-textual-compact {
    padding: 0;
}
