/* ===================================================================
   SERVER ACTIONS SCREEN
   =================================================================== */

#sa-body {
    width: 1fr;
    height: 100%;
    background: $surface;
    layout: vertical;
}

/* Full-width compact context banner leading the screen */
#sa-context {
    width: 100%;
    height: auto;
    max-height: 4;
    padding: 0 1;
    background: transparent;
    border-left: thick $accent;
    border-bottom: solid $surface-lighten-1;
    scrollbar-gutter: stable;
}

#server_context {
    text-align: left;
    content-align: left middle;
    height: auto;
    padding: 0;
}

/* Primary actions: one row, Back at the left and the rest at the right.
   The buttons themselves are ActionButton (components/action_button.tcss). */
#action_buttons {
    width: 100%;
    height: auto;
    layout: horizontal;
    padding: 0 1;
    background: $surface;
}

/* No room: the actions wrap onto further lines instead of being cut off */
ActionRow.-wrap {
    layout: grid;
    grid-size: 2;
    grid-rows: auto;
    grid-gutter: 0 1;
}

#action_buttons.-wrap {
    grid-size: 3;
}

#action_buttons.-wrap .sa-toolbar-spacer {
    display: none;
}

#action_buttons .sa-toolbar-spacer {
    width: 1fr;
    height: 1;
}

/* Main detail workspace (overview + inline tools) */
#sa-detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#sa-overview {
    height: 1fr;
    scrollbar-gutter: stable;
}

#sa-facts,
#sa-monitoring {
    height: auto;
    align-vertical: top;
}

#sa-detail .sa-section {
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    border: round $border-blurred;
    background: transparent;
}

/* Two cards per row, equal width; each card owns the actions that act on it */
#sa-facts .sa-section,
#sa-monitoring .sa-section {
    width: 1fr;
    height: auto;
}

#card_identity,
#card_live {
    margin-right: 1;
}

#server_identity,
#server_info,
#live_stats,
#memory_panel {
    width: 100%;
    height: auto;
}

.sa-card-actions {
    width: 100%;
    height: auto;
    padding: 0;
}

.sa-card-title {
    width: 100%;
    height: auto;
}

#sa-diagnostics .sa-card-actions,
#sa-provider .sa-card-actions {
    padding: 0;
}

ServerActionsScreen.-narrow #sa-facts,
ServerActionsScreen.-narrow #sa-monitoring,
ServerActionsScreen.-content-narrow #sa-facts,
ServerActionsScreen.-content-narrow #sa-monitoring {
    layout: vertical;
}

ServerActionsScreen.-narrow #card_identity,
ServerActionsScreen.-narrow #card_live,
ServerActionsScreen.-content-narrow #card_identity,
ServerActionsScreen.-content-narrow #card_live {
    margin-right: 0;
}

ServerActionsScreen.-narrow #sa-facts .sa-section,
ServerActionsScreen.-narrow #sa-monitoring .sa-section,
ServerActionsScreen.-content-narrow #sa-facts .sa-section,
ServerActionsScreen.-content-narrow #sa-monitoring .sa-section {
    width: 100%;
}

ServerActionsScreen.-narrow .sa-card-actions,
ServerActionsScreen.-content-narrow .sa-card-actions {
    padding: 0;
}

#action_help {
    padding: 0 1;
    height: auto;
    color: $text-muted;
}

#action_help:hover {
    color: $text;
}

/* Slow work indicator: pinned to bottom of detail pane */
#sa_busy {
    dock: bottom;
    padding: 0 2;
}

/* Inline read-only views (Browse / Logs):
   Collapse the action grid so the inline tree/log gets the full vertical viewport */
ServerActionsScreen.-inline-open #action_buttons {
    display: none;
}

#sa-detail.-inline-open #sa-overview {
    display: none;
}

#sa-inline {
    width: 100%;
    height: auto;
    display: none;
}

#sa-inline.visible {
    display: block;
    height: 1fr;
    min-height: 0;
    border: round $border-blurred;
    background: transparent;
}

#sa-inline .inline_title {
    padding: 0 1;
    background: $boost;
    color: $text;
    text-style: bold;
}

#sa-inline .inline_note {
    height: auto;
    padding: 0 1;
    border-top: round $surface-lighten-1;
}

#sa-inline RemoteTree,
#sa-inline RichLog {
    height: 1fr;
}

/* The note remains complete; its separator need not consume a tree row. */
ServerActionsScreen.-short #sa-inline .inline_note {
    border-top: none;
}

/* Short terminal adjustment */
ServerActionsScreen.-short #sa-detail {
    padding: 0 1;
}

ServerActionsScreen.-short #sa-detail .sa-section {
    padding: 0 1;
    margin-bottom: 0;
}

/* One row of compact buttons has to fit the narrowest content column */
ServerActionsScreen.-narrow #action_buttons,
ServerActionsScreen.-content-narrow #action_buttons {
    padding: 0;
}
