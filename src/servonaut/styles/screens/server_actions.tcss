/* ===================================================================
   SERVER ACTIONS SCREEN
   =================================================================== */

#sa-body {
    width: 1fr;
    height: 100%;
    background: $surface;
    layout: vertical;
}

/* Full-width compact context banner leading the screen */
#sa-context {
    width: 100%;
    height: auto;
    max-height: 4;
    padding: 0 1;
    background: transparent;
    border-left: thick $accent;
    border-bottom: solid $surface-lighten-1;
    scrollbar-gutter: stable;
}

#server_context {
    text-align: left;
    content-align: left middle;
    height: auto;
    padding: 0;
}

/* Grouped action toolbar above the overview:
   each category is one row: a fixed-width heading beside its own 3-column
   grid of actions, so columns line up across every group */
#action_buttons {
    width: 100%;
    height: auto;
    layout: vertical;
    padding: 0 1 1 1;
    background: $surface;
    border-bottom: solid $panel-lighten-2;
}

#action_buttons .sa-group {
    width: 100%;
    height: auto;
}

/* Back is set apart from the last category so it never reads as one of its actions */
#action_buttons .sa-group:last-child {
    margin-top: 1;
}

#action_buttons .sa-group-actions {
    width: 1fr;
    height: auto;
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr;
    grid-rows: 1;
    grid-gutter: 0 1;
}

#action_buttons Button {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    border-left: tall $surface-lighten-1;
    background: transparent;
    color: $text;
    text-align: left;
    content-align: left middle;
    /* A button's content box can be exactly 2 cells wide while its line pad is 1,
       so the text would be wrapped at width 0 and the app would crash. Truncating
       instead of wrapping can never reach that path (e.g. while the chat panel
       is still squeezing this column during a resize). */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#action_buttons Button.-primary {
    border-left: tall $primary;
    color: $text-accent;
}

#action_buttons Button.-warning {
    border-left: tall $warning;
    color: $text-warning;
}

#action_buttons Button.-error {
    border-left: tall $error;
    color: $text-error;
}

#action_buttons Button.-primary:ansi,
#action_buttons Button.-warning:ansi,
#action_buttons Button.-error:ansi {
    color: $foreground;
}

#action_buttons Button:hover {
    background: $panel-lighten-1;
    color: $text-accent;
    border-left: tall $accent;
}

#action_buttons Button:focus {
    background: $panel-lighten-2;
    color: $text;
    border: none;
    border-left: tall $accent;
    text-style: bold;
}

#action_buttons .section_label {
    width: 10;
    color: $text-accent;
    text-style: bold;
    padding: 0 1;
    margin: 0;
    height: 1;
}

#action_buttons #btn_back {
    background: transparent;
    color: $text-muted;
}

#action_buttons #btn_back:hover {
    background: $panel-lighten-1;
    color: $text;
}

#action_buttons #btn_back:focus {
    background: $panel-lighten-2;
    color: $text;
    border: none;
    text-style: bold;
}

#action_buttons Button:ansi:hover,
#action_buttons Button.-primary:ansi:hover,
#action_buttons Button.-error:ansi:hover,
#action_buttons #btn_back:ansi:hover {
    background: $surface;
    color: $foreground;
    border: none;
    border-left: tall $accent;
    text-style: underline not bold;
}

#action_buttons Button:ansi:focus,
#action_buttons Button.-primary:ansi:focus,
#action_buttons Button.-error:ansi:focus,
#action_buttons #btn_back:ansi:focus {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    border: none;
    border-left: tall $warning;
    text-style: not bold;
}

/* Narrow view reflow: drop the decorative headings (the rows stay grouped)
   so the three columns get the full width and the overview keeps its height */
ServerActionsScreen.-narrow #action_buttons .section_label,
ServerActionsScreen.-content-narrow #action_buttons .section_label {
    display: none;
}

/* Rows are scarce when narrow: Back keeps its own row but no spacer */
ServerActionsScreen.-narrow #action_buttons .sa-group:last-child,
ServerActionsScreen.-content-narrow #action_buttons .sa-group:last-child {
    margin-top: 0;
}

ServerActionsScreen.-narrow #action_buttons,
ServerActionsScreen.-content-narrow #action_buttons {
    padding: 0 1 0 1;
}

/* Main detail workspace (overview + inline tools) */
#sa-detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#sa-overview {
    height: 1fr;
    scrollbar-gutter: stable;
}

#sa-facts,
#sa-monitoring {
    height: auto;
    align-vertical: top;
}

#sa-detail .sa-section {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: round $border-blurred;
    background: transparent;
}

#server_identity,
#server_info,
#live_stats,
#memory_panel {
    width: 1fr;
}

#server_identity,
#live_stats {
    margin-right: 1;
}

ServerActionsScreen.-narrow #sa-facts,
ServerActionsScreen.-narrow #sa-monitoring,
ServerActionsScreen.-content-narrow #sa-facts,
ServerActionsScreen.-content-narrow #sa-monitoring {
    layout: vertical;
}

ServerActionsScreen.-narrow #server_identity,
ServerActionsScreen.-narrow #live_stats,
ServerActionsScreen.-content-narrow #server_identity,
ServerActionsScreen.-content-narrow #live_stats {
    margin-right: 0;
}

#action_help {
    padding: 0 1;
    height: auto;
    color: $text-muted;
}

#action_help:hover {
    color: $text;
}

/* Slow work indicator: pinned to bottom of detail pane */
#sa_busy {
    dock: bottom;
    padding: 0 2;
}

/* Inline read-only views (Browse / Logs):
   Collapse the action grid so the inline tree/log gets the full vertical viewport */
ServerActionsScreen.-inline-open #action_buttons {
    display: none;
}

#sa-detail.-inline-open #sa-overview {
    display: none;
}

#sa-inline {
    width: 100%;
    height: auto;
    display: none;
}

#sa-inline.visible {
    display: block;
    height: 1fr;
    min-height: 0;
    border: round $border-blurred;
    background: transparent;
}

#sa-inline .inline_title {
    padding: 0 1;
    background: $boost;
    color: $text;
    text-style: bold;
}

#sa-inline .inline_note {
    height: auto;
    padding: 0 1;
    border-top: round $surface-lighten-1;
}

#sa-inline RemoteTree,
#sa-inline RichLog {
    height: 1fr;
}

/* The note remains complete; its separator need not consume a tree row. */
ServerActionsScreen.-short #sa-inline .inline_note {
    border-top: none;
}

/* Short terminal adjustment */
ServerActionsScreen.-short #sa-detail {
    padding: 0 1;
}

ServerActionsScreen.-short #sa-detail .sa-section {
    padding: 0 1;
}

ServerActionsScreen.-short #action_buttons .section_label {
    padding: 0;
}

/* The overview cards carry their own rounded border, so on a short terminal
   the toolbar's divider line would only cost the overview a row. */
ServerActionsScreen.-short #action_buttons {
    border-bottom: none;
}
