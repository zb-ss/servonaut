/* ===================================================================
   SERVER ACTIONS SCREEN
   =================================================================== */

#sa-body {
    width: 1fr;
    height: 100%;
    background: $surface;
}

/* Left: sectioned action rail. On a wide terminal the actions sit two to a
   row (section labels, Browse and Back take a whole row), so every action
   fits without scrolling. A narrow terminal gets one column of one-row
   buttons, and a short one one-row buttons, so the rail still fits and the
   detail pane keeps its width. */
#action_buttons {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    width: 46;
    height: 100%;
    padding: 0 1;
    overflow-y: auto;
    border-right: round $primary;
}

#action_buttons Button {
    width: 100%;
    min-width: 0;
    margin: 0;
}

#action_buttons .section_label {
    column-span: 2;
    color: $accent;
    text-style: bold;
    padding: 1 0 0 0;
    margin: 0;
}

#action_buttons #btn_browse,
#action_buttons #btn_back {
    column-span: 2;
}

ServerActionsScreen.-narrow #action_buttons {
    layout: vertical;
    width: 24;
}

ServerActionsScreen.-narrow #action_buttons Button,
ServerActionsScreen.-short #action_buttons Button {
    height: 1;
    border: none;
    content-align: left middle;
    text-align: left;
}

ServerActionsScreen.-narrow #action_buttons .section_label:first-child,
ServerActionsScreen.-short #action_buttons .section_label:first-child {
    padding: 0;
}

/* Right: detail pane (identity + live + memory + focus help) */
#sa-detail {
    width: 1fr;
    height: 100%;
    padding: 1 3;
    overflow-y: auto;
}

#server_info {
    text-align: left;
    padding: 1 2;
    margin-bottom: 1;
    border: round $primary;
    background: $boost;
}

#live_stats {
    padding: 1 2;
    margin-bottom: 1;
    border: round $accent;
    background: $boost;
}

#memory_panel {
    padding: 1 2;
    margin-bottom: 1;
    border: round $primary;
    background: $boost;
}

#action_help {
    padding: 0 2;
    height: auto;
}

/* Slow work started from this screen (binding a vault key, preparing SSH):
   pinned to the bottom of the detail pane so it stays in view however far
   the panels scroll. Hidden while nothing runs. */
#sa_busy {
    dock: bottom;
    padding: 0 2;
}

/* Inline read-only views (Browse / Logs) mounted below the dashboard panels */
#sa-inline {
    width: 100%;
    height: auto;
    display: none;
}

#sa-inline.visible {
    display: block;
    height: 1fr;
    min-height: 14;
    margin-top: 1;
    border: round $accent;
}

#sa-inline .inline_title {
    padding: 0 1;
    background: $boost;
    color: $accent;
    text-style: bold;
}

#sa-inline .inline_note {
    height: auto;
    padding: 0 1;
    border-top: round $surface-lighten-1;
}

#sa-inline RemoteTree,
#sa-inline RichLog {
    height: 1fr;
}

/* A short terminal: less padding around the detail panels, so the server
   memory stays on screen under the server's details. */
ServerActionsScreen.-short #sa-detail {
    padding: 0 1;
}

ServerActionsScreen.-short #server_info,
ServerActionsScreen.-short #live_stats,
ServerActionsScreen.-short #memory_panel {
    padding: 0 1;
}
