/* ===================================================================
   SETTINGS SCREEN (master/detail)
   Left nav rail of grouped category buttons + a content pane that shows
   only the active panel. Modeled on the #sa-body / #sa-detail layout.
   =================================================================== */

#settings-body {
    width: 1fr;
    height: 100%;
    background: $surface;
    padding: 1;
}

/* Left: the secondary side menu (search + grouped nav buttons). */
#settings-nav {
    width: 28;
    height: 100%;
    padding: 0 1;
    margin-right: 1;
    border: round $primary;
    border-title-color: $text-muted;
    background: transparent;
}

#settings-search {
    width: 100%;
    margin: 0 0 1 0;
    border: round $primary;
}

#settings-search:focus {
    border: round $text-accent;
}

#settings-back,
#settings-search-clear {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 1 0;
    background: transparent;
    color: $text;
    content-align: left middle;
}

#settings-back:hover,
#settings-back:focus,
#settings-search-clear:hover,
#settings-search-clear:focus {
    background: $boost;
    color: $text-accent;
    text-style: bold underline;
}

#settings-search-empty,
#settings-nav-note {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

#settings-search-empty,
#settings-search-clear {
    display: none;
}

#settings-nav-note {
    margin-top: 1;
}

#settings-nav-list {
    width: 100%;
    height: 1fr;
}

#settings-nav-list .settings-nav-btn {
    width: 100%;
    min-width: 0;
    height: 1;
    margin: 0;
    padding: 0 0 0 1;
    border: none;
    border-left: blank $background;
    background: transparent;
    color: $text;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    content-align: left middle;
}

#settings-nav-list .settings-nav-btn.--active {
    background: $boost;
    color: $text-accent;
    border-left: thick $text-accent;
    text-style: bold;
}

#settings-nav-list .settings-nav-btn:hover {
    background: $foreground 10%;
    color: $text;
    text-style: bold;
}

#settings-nav-list .settings-nav-btn.--active:hover {
    background: $primary 25%;
}

#settings-nav-list .settings-nav-btn:ansi:hover {
    background: $background;
    text-style: bold;
}

#settings-nav-list .settings-nav-btn:focus {
    background: $boost;
    color: $text-accent;
    text-style: bold underline;
}

#settings-nav-list SidebarSection {
    margin-bottom: 1;
}

#settings-nav-list SidebarSection > Button.section-header {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    content-align: left middle;
    color: $text-muted;
    text-style: none;
}

#settings-nav-list SidebarSection > Button.section-header:hover {
    background: $foreground 10%;
    text-style: bold;
}

#settings-nav-list SidebarSection > Button.section-header:ansi:hover {
    background: $background;
    text-style: bold;
}

#settings-nav-list SidebarSection > Button.section-header:focus {
    background: $boost;
    color: $text-accent;
    text-style: bold underline;
}

/* Shade the open group's button tray so its sub-items read as nested under the
   expanded header. Collapsed sections set their content to display:none, so
   only the currently-expanded group shows the shade. Scoped to the settings
   nav list so the main sidebar's sections are unaffected. */
#settings-nav-list .section-content {
    background: transparent;
    padding: 0 0 0 1;
}

/* Right: the content pane; panels mount here, hidden except the active one. */
#settings-content {
    width: 1fr;
    height: 100%;
    padding: 0;
    overflow-y: hidden;
}

/* The panel fills the content pane (height 100%) and lays its children out
   vertically: a pinned title, a 1fr scrolling body, then a pinned status row
   and Save dock. This keeps Save visible even when a panel's form is taller
   than the screen — the body scrolls internally instead of the dock sliding
   off the bottom. */
.settings-panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
    border: round $primary;
    background: transparent;
}

/* Placeholder for a panel that failed to build — short, no scrolling body. */
.settings-panel.panel-unavailable {
    height: auto;
    border: round $warning;
    color: $text-muted;
}

/* Inside a settings panel, every generic grouping container sizes to its
   content so form rows sit directly under one another. Without this, Textual's
   Vertical / VerticalScroll / Container / Grid all default to height:1fr and
   greedily fill space, opening page-height gaps between sections. The single
   scrollable body is re-pinned to 1fr just below (higher specificity wins), and
   a panel may still opt a specific child back into a bounded scroll via an id
   rule (e.g. #scan_rules_scroll). */
.settings-panel Vertical,
.settings-panel VerticalScroll,
.settings-panel Container,
.settings-panel Grid {
    height: auto;
}

/* Scrollable form body — absorbs all spare vertical space so the title above
   and the status/Save below stay pinned to the visible area. The child
   combinator outranks the content-sizing blanket above. */
.settings-panel > .panel-body {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

.panel-status {
    height: auto;
    color: $error;
    margin: 1 0 0 0;
}

.panel-save-dock {
    height: auto;
    align: right middle;
    padding: 1 0 0 0;
    border-top: solid $primary 30%;
}

.panel-save-dock Button {
    width: auto;
    min-width: 16;
    margin: 0;
}

.settings-panel .dirty-marker {
    width: 1fr;
    height: auto;
    color: $text;
    content-align: left middle;
}

.field-error {
    border: round $error;
}

/* -------------------------------------------------------------------
   Settings form rows
   Wide terminals: a fixed label column, the field takes the rest of the
   row. Inputs, selects and switches are all three rows tall, so labels
   (and any value text sharing the row) are three rows tall too with the
   text centred; otherwise a label sits on the field's top border row.
   Every field keeps the same one-cell right margin so their right edges
   line up.
   ------------------------------------------------------------------- */

.settings-panel .setting_row .label {
    width: 24;
    text-align: left;
    padding-right: 1;
}

.settings-panel .settings-scalar-row {
    margin: 0 0 1 0;
}

.settings-panel .setting_row Input {
    border: round $primary 50%;
}

.settings-panel .setting_row Input:focus {
    border: round $text-accent;
}

.settings-panel .setting_row Input.field-error {
    border: round $error;
}

.settings-panel .setting_row > Static {
    min-height: 3;
    content-align-vertical: middle;
}

.settings-panel .setting_row Select,
.settings-panel .setting_row EnvVarInput {
    width: 1fr;
    margin-right: 1;
}

/* EnvVarInput already carries the row margin; its inner Input must not add
   a second one. */
.settings-panel .setting_row EnvVarInput > Input {
    margin-right: 0;
}

/* Start the selected value where an Input starts its text. */
.settings-panel .setting_row SelectCurrent {
    padding: 0 1;
}

/* The list editors size their small buttons in their own defaults, but the
   stylesheet's global Button minimum (16 cells) outranks those, which
   leaves the value input a sliver of the row on a narrow screen. */
StringListEditor .list-remove,
KeyValueEditor .kv-remove {
    width: 5;
    min-width: 5;
}

StringListEditor .list-add,
KeyValueEditor .kv-add {
    width: auto;
    min-width: 9;
}

/* Narrow content (see SettingsScreen.CONTENT_NARROW_WIDTH): a label
   column would leave no room for the field, so each label sits above its
   field, and the pane and panel give up most of their side padding. */
SettingsScreen.-content-narrow #settings-content {
    padding: 0;
}

SettingsScreen.-content-narrow #settings-nav {
    width: 28;
}

SettingsScreen.-content-narrow .settings-panel {
    padding: 0 1;
}

SettingsScreen.-content-narrow .settings-panel .setting_row {
    layout: vertical;
    margin: 0 0 1 0;
}

SettingsScreen.-content-narrow .settings-panel .setting_row .label {
    width: 100%;
    padding: 0;
    text-align: left;
}

SettingsScreen.-content-narrow .settings-panel .setting_row > Static {
    min-height: 1;
}

/* A row of action buttons (Add / Edit / Remove …) overflows the pane at the
   global 16-cell button minimum; sized to their labels they fit. The list
   editors' add/remove buttons keep their own, smaller minimum. */
SettingsScreen.-content-narrow .settings-panel .panel-body Horizontal > Button {
    min-width: 8;
}

SettingsScreen.-content-narrow .settings-panel .panel-body StringListEditor Horizontal > Button,
SettingsScreen.-content-narrow .settings-panel .panel-body KeyValueEditor Horizontal > Button {
    min-width: 5;
}

/* Short terminals (see SettingsScreen.VERTICAL_BREAKPOINTS): drop the
   vertical padding so the form body keeps most of the height. */
SettingsScreen.-short #settings-content {
    padding-top: 0;
    padding-bottom: 0;
}

SettingsScreen.-short #settings-body {
    padding: 0 1;
}

SettingsScreen.-short #settings-back {
    margin: 0 0 1 0;
}

SettingsScreen.-short .settings-panel {
    padding-top: 0;
    padding-bottom: 0;
}

SettingsScreen.-short .panel-save-dock {
    padding: 0;
}

/* Keep setup action labels and their download sizes visible in narrow panels. */
VoicePanel .voice-action-row Button {
    max-width: 100%;
    height: auto;
}

/* Account actions keep complete labels within the editable pane. */
SettingsScreen AccountsSection .accounts-actions {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
}

SettingsScreen AccountsSection .accounts-action {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: auto;
    margin: 0;
}

/* Category directory, active context, and one bounded form surface. */
SettingsScreen #settings-body {
    padding: 1;
    background: $surface;
}

SettingsScreen #settings-nav {
    width: 26;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: transparent;
}

SettingsScreen #settings-back {
    color: $text-muted;
}

SettingsScreen #settings-search {
    border: round $border-blurred;
    background: transparent;
}

SettingsScreen #settings-search:focus {
    border: round $accent;
}

SettingsScreen #settings-nav-list .settings-nav-btn {
    height: auto;
    min-height: 1;
    text-wrap: wrap;
    text-overflow: fold;
}

SettingsScreen #settings-nav-list .settings-nav-btn.--active {
    background: $boost;
    color: $text;
    border-left: thick $accent;
}

SettingsScreen #settings-nav-list SidebarSection > Button.section-header {
    height: auto;
    min-height: 1;
    text-wrap: wrap;
    text-overflow: fold;
}

SettingsScreen #settings-nav-note {
    padding: 1 0;
    color: $text-muted;
}

SettingsScreen .settings-panel {
    padding: 0;
    border: none;
    background: transparent;
}

SettingsScreen .settings-panel > .panel-context {
    height: auto;
    padding: 0 1 1 1;
    background: transparent;
}

SettingsScreen .settings-panel > .panel-body {
    height: 1fr;
    min-height: 1;
    padding: 1 2;
    border: round $border-blurred;
    background: transparent;
    scrollbar-gutter: stable;
}

SettingsScreen .settings-form-section {
    height: auto;
    margin-bottom: 1;
    background: transparent;
}

SettingsScreen .settings-group-title {
    height: auto;
    margin-bottom: 1;
    color: $text;
    text-style: bold;
}

SettingsScreen .settings-panel > .panel-status {
    margin: 0;
    padding: 0 1;
}

SettingsScreen .settings-panel > .panel-save-dock {
    height: auto;
    padding: 1 1 0 1;
    border-top: none;
    background: transparent;
}

SettingsScreen .panel-save-dock Button {
    border: round $accent;
    background: transparent;
    color: $text;
}

SettingsScreen .panel-save-dock Button:focus,
SettingsScreen .panel-save-dock Button:hover {
    border: round $accent;
    background: transparent;
    text-style: bold underline;
}

SettingsScreen.-content-narrow #settings-nav {
    width: 26;
}

SettingsScreen.-content-narrow .settings-panel {
    padding: 0;
}

SettingsScreen.-content-narrow .settings-panel > .panel-body {
    padding: 0 1;
}

SettingsScreen.-short #settings-body {
    padding: 0 1;
}

SettingsScreen.-short .settings-panel > .panel-context {
    padding: 0 1;
}

SettingsScreen.-short .settings-panel > .panel-save-dock {
    padding: 0 1;
}

/* Provider form sections share the single Settings reading surface. */
SettingsScreen .settings-provider-section {
    border-top: solid $border-blurred;
    padding-top: 1;
}

SettingsScreen .settings-group-title {
    padding: 0;
    margin: 0 0 1 0;
}

SettingsScreen AccountsSection .accounts-heading {
    padding: 0;
    margin: 0 0 1 0;
    color: $text;
    text-style: bold;
}

SettingsScreen AccountsSection .accounts-help {
    padding: 0 0 1 0;
}

SettingsScreen AccountsSection .accounts-records {
    padding: 0 1 1 1;
    border: round $border-blurred;
    background: transparent;
}

SettingsScreen AccountsSection .accounts-table {
    border: none;
    background: $surface;
}

SettingsScreen AwsAccountsSection #aws_account_form {
    padding: 0 1 1 1;
    border: round $border-blurred;
    background: transparent;
}

SettingsScreen AwsAccountsSection #aws_account_form_title {
    padding: 0 0 1 0;
    color: $text;
}

SettingsScreen AwsAccountsSection #aws_account_form_actions {
    padding-top: 0;
    margin: 0;
    border-top: solid $border-blurred;
}

/* Setup grids place complete labels above each field, including on wide views. */
HetznerSetupScreen .provider_setup_context .note,
OVHSetupScreen .provider_setup_context .note {
    padding: 0 0 1 0;
}

HetznerSetupScreen .provider_setup_grid .provider_form_section,
OVHSetupScreen .provider_setup_grid .provider_form_section {
    margin-bottom: 0;
}

HetznerSetupScreen .provider_setup_grid .setting_row,
OVHSetupScreen .provider_setup_grid .setting_row {
    layout: vertical;
    height: auto;
    margin-bottom: 1;
}

HetznerSetupScreen .provider_setup_grid .setting_row .label,
OVHSetupScreen .provider_setup_grid .setting_row .label {
    width: 100%;
    height: auto;
    padding: 0;
    text-align: left;
    color: $text-muted;
}

HetznerSetupScreen .provider_setup_grid .setting_row > Input,
HetznerSetupScreen .provider_setup_grid .setting_row > Select,
HetznerSetupScreen .provider_setup_grid .setting_row > SecretInput,
OVHSetupScreen .provider_setup_grid .setting_row > Input,
OVHSetupScreen .provider_setup_grid .setting_row > Select,
OVHSetupScreen .provider_setup_grid .setting_row > SecretInput {
    width: 100%;
    margin: 0;
}
