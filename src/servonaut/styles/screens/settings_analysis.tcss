/* Analysis, voice and log settings use the shell's content-sized form groups. */

AiChatPanel .settings-analysis-section,
AiProviderPanel .settings-analysis-section,
VoicePanel .settings-analysis-section,
ScanPanel .settings-analysis-section,
LogViewerPanel .settings-analysis-section,
CloudtrailPanel .settings-analysis-section,
CloudwatchPanel .settings-analysis-section {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    background: $surface;
    border-left: solid $border-blurred;
}

AiChatPanel .settings-analysis-section:focus-within,
AiProviderPanel .settings-analysis-section:focus-within,
VoicePanel .settings-analysis-section:focus-within,
ScanPanel .settings-analysis-section:focus-within,
LogViewerPanel .settings-analysis-section:focus-within,
CloudtrailPanel .settings-analysis-section:focus-within,
CloudwatchPanel .settings-analysis-section:focus-within {
    border-left: solid $accent;
}

AiProviderPanel .settings-analysis-context,
VoicePanel .settings-analysis-context {
    padding: 0 1;
    background: $panel;
    border-left: heavy $accent;
}

AiChatPanel .ai-chat-section-header,
VoicePanel .voice-section-header,
ScanPanel .scan-section-title,
LogViewerPanel .lv-section-header,
AiProviderPanel .settings-group-title,
CloudtrailPanel .settings-group-title,
CloudwatchPanel .settings-group-title {
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
    color: $text-accent;
    text-style: bold;
}

AiChatPanel .ai-chat-help,
AiProviderPanel .ai-note,
VoicePanel .voice-help,
LogViewerPanel .lv-help {
    height: auto;
    padding: 0;
    margin: 0 0 1 0;
    color: $text-muted;
}

AiChatPanel .ai-chat-warning {
    height: auto;
    padding: 0;
    margin-bottom: 1;
    color: $text-warning;
}

AiChatPanel TextArea {
    height: 8;
    width: 100%;
    margin: 0 0 1 0;
    border: round $border-blurred;
    background: transparent;
}

AiChatPanel TextArea:focus {
    border: round $accent;
}

AiProviderPanel #ai_provider_servonaut_status {
    width: 1fr;
    height: auto;
    min-height: 3;
    padding: 0 1 0 0;
}

AiProviderPanel .ai-status-row {
    height: auto;
    margin: 0;
}

AiProviderPanel #ai_provider_upgrade {
    width: auto;
    min-width: 12;
    margin: 0;
}

VoicePanel #voice_status_banner {
    height: auto;
    padding: 0;
    margin-bottom: 1;
}

VoicePanel #voice_requirements,
VoicePanel #voice_tts_requirements,
VoicePanel #voice_vad_requirements {
    height: auto;
    margin-bottom: 1;
}

VoicePanel .voice-req-row {
    height: auto;
    margin: 0;
}

VoicePanel .voice-req-label,
VoicePanel .voice-req-state {
    height: auto;
}

VoicePanel .voice-command {
    height: auto;
    padding: 0 1;
    color: $text-muted;
}

VoicePanel .voice-action-row {
    layout: vertical;
    height: auto;
    margin: 0 0 1 0;
}

VoicePanel .voice-action-row Button {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
}

VoicePanel #voice_download_row {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $panel;
}

ScanPanel #scan_rules_container {
    height: auto;
}

ScanPanel .scan-rule-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    border: round $border-blurred;
    background: transparent;
}

ScanPanel .scan-rule-card:focus-within {
    border: round $accent;
}

ScanPanel .scan-rule-header {
    height: auto;
    border-bottom: solid $border-blurred;
    margin-bottom: 1;
}

ScanPanel .scan-rule-name-label {
    height: auto;
    color: $text;
}

ScanPanel .scan-rule-sublabel {
    height: auto;
    padding: 0;
    color: $text-muted;
}

ScanPanel .scan-add-rule-row {
    height: auto;
    margin-top: 1;
}

SettingsScreen.-content-narrow AiProviderPanel .ai-status-row {
    layout: vertical;
}

SettingsScreen.-content-narrow AiProviderPanel #ai_provider_servonaut_status {
    width: 100%;
    min-height: 1;
}

SettingsScreen.-content-narrow AiProviderPanel #ai_provider_upgrade {
    width: 100%;
}

SettingsScreen.-content-narrow VoicePanel .voice-req-row {
    layout: vertical;
}

SettingsScreen.-content-narrow VoicePanel .voice-req-label,
SettingsScreen.-content-narrow VoicePanel .voice-req-state {
    width: 100%;
}
