/* ===================================================================
   SETTINGS › APPEARANCE
   Theme cards, the preview beside them and the readability readout.
   =================================================================== */

AppearancePanel #appearance_header {
    height: auto;
    layout: vertical;
    padding: 0 1;
}
AppearancePanel #appearance_header.-wide {
    layout: horizontal;
}
AppearancePanel #appearance_heading {
    width: 100%;
    height: auto;
}
AppearancePanel #appearance_header.-wide #appearance_heading {
    width: 1fr;
}
AppearancePanel #appearance_description {
    margin: 0;
}
AppearancePanel #appearance_actions {
    width: auto;
    height: auto;
}
AppearancePanel #appearance_new,
AppearancePanel #appearance_open,
AppearancePanel #appearance_reload {
    width: auto;
    min-width: 10;
    margin: 0 1 0 0;
}
AppearancePanel #appearance_header.-wide #appearance_reload {
    margin: 0;
}
AppearancePanel #appearance_actions Button.-textual-compact {
    min-width: 0;
    height: 1;
    border: none;
}
AppearancePanel #appearance_layout {
    height: 1fr;
    width: 100%;
}
AppearancePanel #appearance_layout.-stacked {
    layout: vertical;
    overflow-y: auto;
}
AppearancePanel #appearance_layout.-side {
    layout: horizontal;
}
AppearancePanel #appearance_cards {
    width: 1fr;
    height: auto;
    grid-size: 1;
    grid-gutter: 0 1;
    grid-rows: auto;
    overflow-y: hidden;
}
AppearancePanel #appearance_layout.-side #appearance_cards {
    height: 1fr;
    overflow-y: auto;
    padding-right: 1;
}
AppearancePanel #appearance_cards.-cols-2 { grid-size: 2; }
AppearancePanel #appearance_cards.-cols-3 { grid-size: 3; }
AppearancePanel .theme-card {
    height: auto;
    padding: 0 1;
    border: round $border-blurred;
    background: transparent;
}
AppearancePanel .theme-card:focus {
    border: round $primary;
}
AppearancePanel .theme-card.-active {
    border: round $accent;
}
AppearancePanel .theme-card.-warning {
    border: round $warning;
}
AppearancePanel .theme-card.-error {
    border: round $error;
}
AppearancePanel .theme-card-title {
    height: auto;
}
/* After the state rules: the border carries the state colour, so focus is shown on the title. */
AppearancePanel .theme-card:focus .theme-card-title {
    background: $boost;
    text-style: bold underline;
}
AppearancePanel .theme-card-swatches {
    height: 1;
}
AppearancePanel .theme-card-detail {
    height: auto;
    color: $text-muted;
}
AppearancePanel .theme-card-path {
    height: auto;
}
AppearancePanel .theme-card-path .theme-card-detail {
    width: 1fr;
}
AppearancePanel .theme-card-warning {
    height: auto;
}
AppearancePanel .theme-card-path .theme-edit-file {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0 0 0 2;
    border: none;
    padding: 0;
    text-style: underline;
}
AppearancePanel #appearance_details {
    height: auto;
    width: 100%;
}
AppearancePanel #appearance_layout.-side #appearance_details {
    width: 36;
    height: 1fr;
    overflow-y: auto;
}
AppearancePanel .appearance-section {
    height: auto;
    width: 100%;
    padding: 0 1;
    border: round $border-blurred;
    background: transparent;
}
AppearancePanel #appearance_preview_title,
AppearancePanel #appearance_readability_title,
AppearancePanel .appearance-section-title {
    height: auto;
    color: $text-muted;
    text-style: bold;
}
AppearancePanel #appearance_preview {
    height: auto;
    padding: 0;
}
AppearancePanel #appearance_readability {
    height: auto;
}
AppearancePanel #appearance_hint {
    height: auto;
    color: $text-muted;
    margin-top: 1;
}

